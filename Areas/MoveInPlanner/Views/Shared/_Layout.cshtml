@{
    var isLoggedIn = User.Identity?.IsAuthenticated == true;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Move In Planner</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Fraunces:opsz,wght@9..144,650&display=swap" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="~/move-in-planner/css/site.css" asp-append-version="true" />
</head>
<body>
<header class="app-header">
    <nav class="container nav-shell">
        <a asp-controller="Dashboard" asp-action="Index" class="brand"><span class="brand-mark">M</span><span>Move In Planner</span></a>
        <div class="nav-links">
            <a asp-controller="Dashboard" asp-action="Index">Dashboard</a>
            <a asp-controller="Items" asp-action="Index">All items</a>
        </div>
        <div class="app-switcher" aria-label="Switch application">
            <a href="/Dashboard/Index">Finance Manager</a>
            <a href="/Items/Index">Personal Vault</a>
        </div>
        @if (isLoggedIn)
        {
            <a asp-controller="Items" asp-action="Create" class="btn btn-primary btn-sm">+ Add item</a>
        }
        else
        {
            <a asp-area="" asp-controller="Auth" asp-action="Login" asp-route-returnUrl="@Context.Request.Path" class="btn btn-primary btn-sm">Login to edit</a>
        }
    </nav>
</header>
<main class="container app-main">
    @if (!isLoggedIn)
    {
        <div class="alert alert-info" role="status">Read-only mode — log in to add or edit move-in items.</div>
    }
    @if (TempData["Success"] is string message)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">@message<button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>
    }
    @RenderBody()
</main>
<footer class="container app-footer">Move In Planner · ASP.NET Core MVC + EF Core</footer>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
