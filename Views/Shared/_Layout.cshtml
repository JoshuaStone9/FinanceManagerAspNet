@{
    var controller = ViewContext.RouteData.Values["controller"]?.ToString();
    var action = ViewContext.RouteData.Values["action"]?.ToString();
    var isVault = controller == "Items" || controller == "Locations" || controller == "VaultSettings";
    var isLoggedIn = User.Identity?.IsAuthenticated == true;
}
<!doctype html>
<html lang="en" data-theme="dark">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>@ViewData["Title"] - @(isVault ? "Personal Vault" : "Finance Manager")</title>
  <link rel="icon" type="image/png" sizes="32x32" href="~/images/favicon-32.png" />
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap" rel="stylesheet">
  @if (isVault)
  {
    <link rel="stylesheet" href="~/css/personalvault.css" asp-append-version="true" />
  }
  else
  {
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
  }
</head>
<body>
@if (isVault)
{
    <div class="app-shell">
        <aside class="sidebar" id="sidebar">
            <div class="brand">
                <span class="brand-icon"><i data-lucide="box"></i></span>
                <span class="brand-text">Personal Vault</span>
            </div>

            <nav class="nav-section nav-section--primary">
                <a class="nav-link fm-link" asp-controller="Dashboard" asp-action="Index">
                    <i data-lucide="wallet"></i> <span>Finance Manager</span>
                </a>
                <a class="nav-link @(controller == "Items" && action == "Index" ? "active" : "")" asp-controller="Items" asp-action="Index">
                    <i data-lucide="layout-dashboard"></i> <span>Vault Dashboard</span>
                </a>
                <button class="theme-toggle-inline" id="themeToggleInline" type="button">Toggle theme</button>
      @if (isLoggedIn)
                {
                    <a class="nav-link nav-link--add @(controller == "Items" && action == "Create" ? "active" : "")" asp-controller="Items" asp-action="Create">
                        <i data-lucide="plus-circle"></i> <span>Add Item</span>
                    </a>
                    <a class="nav-link @(controller == "Locations" ? "active" : "")" asp-controller="Locations" asp-action="Index">
                        <i data-lucide="map-pin"></i> <span>Locations</span>
                    </a>
                    <a class="nav-link @(controller == "VaultSettings" ? "active" : "")" asp-controller="VaultSettings" asp-action="Index">
                        <i data-lucide="sliders-horizontal"></i> <span>Vault Settings</span>
                    </a>
                }
            </nav>

            <div class="nav-section nav-section--scroll">
                <div class="nav-heading">Categories</div>
                @if (ViewBag.SidebarCategories != null)
                {
                    foreach (var c in ViewBag.SidebarCategories)
                    {
                        <a class="nav-link nav-link--sub" asp-controller="Items" asp-action="Index" asp-route-CategoryId="@c.Id">
                            <i data-lucide="tag"></i>
                            <span>@c.Name</span>
                            <span class="badge-count">@c.ItemCount</span>
                        </a>
                    }
                }
            </div>

            <div class="sidebar-footer">
                <button class="theme-toggle" id="themeToggle" type="button" title="Toggle theme">
                    <i data-lucide="sun-moon"></i> <span>Toggle theme</span>
                </button>
            </div>
        </aside>

        <div class="main-col">
            <header class="topbar">
                <button class="icon-btn sidebar-toggle" id="sidebarToggle" type="button" title="Toggle sidebar">
                    <i data-lucide="menu"></i>
                </button>
                <form class="search-form" asp-controller="Items" asp-action="Index" method="get">
                    <i data-lucide="search" class="search-icon"></i>
                    <input type="text" name="Search" value="@(ViewBag.Filter?.Search)" placeholder="Search Personal Vault..." class="search-input" />
                </form>
                <div class="topbar-actions">
                    @if (isLoggedIn)
                    {
                        <a class="btn btn-primary" asp-controller="Items" asp-action="Create"><i data-lucide="plus"></i> <span>Add Item</span></a>
                        <form asp-controller="Auth" asp-action="Logout" method="post">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="nav-button"><i data-lucide="log-out"></i> <span>Logout</span></button>
                        </form>
                    }
                    else
                    {
                        <a class="btn btn-primary" asp-controller="Auth" asp-action="Login"><i data-lucide="log-in"></i> <span>Login</span></a>
                    }
                </div>
            </header>

            <main class="content">
                @if (!isLoggedIn)
                {
                    <div class="readonly-banner-vault">Read-only mode — login to unlock editing and location details.</div>
                }
                @if (TempData["Success"] != null)
                {
                    <div class="toast toast-success"><i data-lucide="check-circle-2"></i><span>@TempData["Success"]</span></div>
                }
                @if (TempData["Error"] != null)
                {
                    <div class="toast toast-error"><i data-lucide="alert-circle"></i><span>@TempData["Error"]</span></div>
                }
                @RenderBody()
            </main>
        </div>
    </div>
}
else
{
  <div class="fm-app-shell" id="fmAppShell">
    <aside class="fm-sidebar" id="fmSidebar" aria-label="Primary navigation">
      <div class="fm-sidebar-brand">
        <a asp-controller="Dashboard" asp-action="Index" class="fm-brand-link" aria-label="Finance Manager dashboard">
          <img src="~/images/finance-manager-logo.png" alt="" class="fm-brand-logo" />
          <span class="fm-brand-copy"><strong>Finance Manager</strong></span>
        </a>
        <button class="fm-sidebar-collapse" id="fmSidebarCollapse" type="button" title="Collapse sidebar" aria-label="Collapse sidebar" aria-expanded="true">
          <i data-lucide="chevron-left" data-sidebar-icon></i>
        </button>
      </div>

      <nav class="fm-sidebar-nav">
        <a class="fm-nav-item @(controller == "Dashboard" ? "active" : "")" data-tooltip="Dashboard" asp-controller="Dashboard" asp-action="Index">
          <i data-lucide="house"></i><span>Dashboard</span>
        </a>

        <div class="fm-nav-group">
          <p class="fm-nav-heading">Finance</p>
          <a class="fm-nav-item @(controller == "Statistics" ? "active" : "")" data-tooltip="Statistics" asp-controller="Statistics" asp-action="Index"><i data-lucide="chart-no-axes-combined"></i><span>Statistics</span></a>
          <a class="fm-nav-item @(controller == "MonthlyFundingReview" ? "active" : "")" data-tooltip="Monthly Review" asp-controller="MonthlyFundingReview" asp-action="Index"><i data-lucide="clipboard-check"></i><span>Monthly Review</span></a>
          <a class="fm-nav-item @(controller == "Forecast" ? "active" : "")" data-tooltip="Forecast" asp-controller="Forecast" asp-action="Index"><i data-lucide="trending-up"></i><span>Forecast</span></a>
        </div>

        <div class="fm-nav-group">
          <p class="fm-nav-heading">Monthly money</p>
          <a class="fm-nav-item @(controller == "MonthlyMoney" && action == "Income" ? "active" : "")" data-tooltip="Income" asp-controller="MonthlyMoney" asp-action="Income"><i data-lucide="wallet-cards"></i><span>Income</span></a>
          <a class="fm-nav-item @(controller == "MonthlyMoney" && action == "EssentialBills" ? "active" : "")" data-tooltip="Essential Bills" asp-controller="MonthlyMoney" asp-action="EssentialBills"><i data-lucide="receipt"></i><span>Essential Bills</span></a>
          <a class="fm-nav-item @(controller == "MonthlyMoney" && action == "EverydaySpending" ? "active" : "")" data-tooltip="Everyday Spending" asp-controller="MonthlyMoney" asp-action="EverydaySpending"><i data-lucide="shopping-basket"></i><span>Everyday Spending</span></a>
          <a class="fm-nav-item @(controller == "MonthlyMoney" && action == "ExtraExpenses" ? "active" : "")" data-tooltip="Extra Expenses" asp-controller="MonthlyMoney" asp-action="ExtraExpenses"><i data-lucide="circle-plus"></i><span>Extra Expenses</span></a>
          <a class="fm-nav-item @(controller == "MonthlyMoney" && action == "Investments" ? "active" : "")" data-tooltip="Investments" asp-controller="MonthlyMoney" asp-action="Investments"><i data-lucide="chart-pie"></i><span>Investments</span></a>
          <a class="fm-nav-item @(controller == "MonthlyMoney" && action == "MoneyPots" ? "active" : "")" data-tooltip="Money Pots Funding" asp-controller="MonthlyMoney" asp-action="MoneyPots"><i data-lucide="piggy-bank"></i><span>Money Pots</span></a>
        </div>

        <div class="fm-nav-group">
          <p class="fm-nav-heading">Money</p>
          <a class="fm-nav-item @(controller == "Assets" ? "active" : "")" data-tooltip="Assets" asp-controller="Assets" asp-action="Index"><i data-lucide="landmark"></i><span>Assets</span></a>
          <a class="fm-nav-item @(controller == "SavingPots" ? "active" : "")" data-tooltip="Money Pots" asp-controller="SavingPots" asp-action="Index"><i data-lucide="piggy-bank"></i><span>Money Pots</span></a>
          <a class="fm-nav-item @(controller == "Events" ? "active" : "")" data-tooltip="Events" asp-controller="Events" asp-action="Index"><i data-lucide="calendar-days"></i><span>Events</span></a>
          <a class="fm-nav-item @(controller == "Reminders" ? "active" : "")" data-tooltip="Reminders" asp-controller="Reminders" asp-action="Index"><i data-lucide="bell"></i><span>Reminders</span></a>
        </div>

        <div class="fm-nav-group">
          <p class="fm-nav-heading">Personal</p>
          <a class="fm-nav-item" data-tooltip="Vault" asp-controller="Items" asp-action="Index"><i data-lucide="lock-keyhole"></i><span>Vault</span></a>
        </div>
      </nav>

      <div class="fm-sidebar-footer">
        <button class="fm-nav-item fm-nav-button" data-tooltip="Theme" id="themeToggle" type="button"><i data-lucide="sun-moon"></i><span>Theme</span></button>
        <a class="fm-nav-item disabled" data-tooltip="Settings" href="#" aria-disabled="true" title="Settings arrives later in Phase 8"><i data-lucide="settings"></i><span>Settings</span><small>Soon</small></a>
        @if (isLoggedIn)
        {
          <form asp-controller="Auth" asp-action="Logout" method="post">
            @Html.AntiForgeryToken()
            <button type="submit" class="fm-nav-item fm-nav-button" data-tooltip="Logout"><i data-lucide="log-out"></i><span>Logout</span></button>
          </form>
        }
        else
        {
          <a class="fm-nav-item" data-tooltip="Login" asp-controller="Auth" asp-action="Login"><i data-lucide="log-in"></i><span>Login</span></a>
        }
      </div>
    </aside>

    <div class="fm-main-column">
      <header class="fm-mobile-header">
        <button class="fm-icon-button" id="fmMobileMenu" type="button" aria-label="Open navigation"><i data-lucide="menu"></i></button>
        <a asp-controller="Dashboard" asp-action="Index" class="fm-mobile-brand">Finance Manager</a>
        <button class="fm-icon-button" id="themeToggleInline" type="button" aria-label="Toggle theme"><i data-lucide="sun-moon"></i></button>
      </header>
      <div class="fm-sidebar-backdrop" id="fmSidebarBackdrop"></div>
      @if (!isLoggedIn)
      {
        <div class="readonly-banner">Read-only mode — login to unlock editing.</div>
      }
      <main class="fm-page-container">
        @if (TempData["Success"] != null)
        {
          <div class="fm-alert fm-alert-success"><i data-lucide="check-circle-2"></i><strong>@TempData["Success"]</strong></div>
        }
        @if (TempData["Error"] != null)
        {
          <div class="fm-alert fm-alert-error"><i data-lucide="alert-circle"></i><strong>@TempData["Error"]</strong></div>
        }
        @RenderBody()
      </main>
    </div>
  </div>
}
  <script src="https://unpkg.com/lucide@latest/dist/umd/lucide.js"></script>
  <script src="~/js/site.js" asp-append-version="true"></script>
  @await RenderSectionAsync("Scripts", false)
</body>
</html>
