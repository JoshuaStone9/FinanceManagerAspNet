@model FinanceManagerAspNet.Models.FinanceRemindersViewModel
@{
    ViewData["Title"] = "Financial Tasks";
    var canEdit = User.Identity?.IsAuthenticated == true;
    string PriorityClass(string priority) => priority switch { "High" => "danger", "Medium" => "warning", _ => "neutral" };
}
<section class="hero card financial-task-hero">
    <div>
        <p class="eyebrow">Phase 10.13</p>
        <h1>Financial Tasks</h1>
        <p class="muted">One place for reminders you create and smart prompts generated from your financial data.</p>
    </div>
    <div class="task-hero-metrics">
        <span><strong>@Model.OpenCount</strong> open</span>
        <span><strong>@Model.DueCount</strong> due</span>
    </div>
</section>

<section class="card task-filter-card">
    <div>
        <p class="eyebrow">Task inbox</p>
        <h2>Filter by status</h2>
    </div>
    <div class="actions">
        <a class="@(Model.Status == "Open" ? "primary" : "secondary") button" asp-route-status="Open">Open</a>
        <a class="@(Model.Status == "Completed" ? "primary" : "secondary") button" asp-route-status="Completed">Completed</a>
        <a class="@(Model.Status == "Dismissed" ? "primary" : "secondary") button" asp-route-status="Dismissed">Dismissed</a>
        <a class="@(Model.Status == "All" ? "primary" : "secondary") button" asp-route-status="All">All</a>
    </div>
</section>

@if (Model.SmartTasks.Count > 0)
{
<section class="card">
    <div class="task-section-heading">
        <div><p class="eyebrow">Smart prompts</p><h2>Suggested next actions</h2></div>
        <span class="task-count-badge">@Model.SmartTasks.Count</span>
    </div>
    <div class="financial-task-grid">
        @foreach (var task in Model.SmartTasks)
        {
            <a class="financial-task-card priority-@PriorityClass(task.Priority)" href="@Url.Content(task.Url)">
                <span class="financial-task-icon"><i data-lucide="@task.Icon"></i></span>
                <span class="financial-task-content">
                    <span class="task-card-meta"><b>@task.Priority priority</b><small>@task.Category</small></span>
                    <strong>@task.Title</strong>
                    <small>@task.Detail</small>
                    @if (task.DueDate.HasValue) { <span class="task-due">Due @task.DueDate.Value.ToString("dd MMM yyyy")</span> }
                </span>
                <i data-lucide="arrow-up-right"></i>
            </a>
        }
    </div>
</section>
}

@if (canEdit && Model.Status is "Open" or "All")
{
<section class="card" id="new-reminder">
    <div class="task-section-heading"><div><p class="eyebrow">Manual task</p><h2>Add a financial task</h2></div></div>
    <form asp-action="Create" method="post" class="financial-task-form">
        @Html.AntiForgeryToken()
        <label>Title<input name="title" required maxlength="220" placeholder="e.g. Review car insurance renewal" /></label>
        <label>Money Pot (optional)<select name="reservePotId"><option value="">General financial task</option>@foreach(var pot in Model.Pots){<option value="@pot.Id">@pot.Name</option>}</select></label>
        <label>Due date<input name="dueDate" type="date" value="@DateTime.Today.ToString("yyyy-MM-dd")" required /></label>
        <label class="full-row">Notes<textarea name="description" rows="3" placeholder="Add any context, amount or next step..."></textarea></label>
        <div class="full-row"><button class="primary">Add financial task</button></div>
    </form>
</section>
}

@if (Model.Reminders.Count == 0)
{
<section class="card"><div class="fm-empty-state"><i data-lucide="circle-check-big"></i><strong>No @Model.Status.ToLowerInvariant() manual tasks</strong><span>Tasks you create and automatic Money Pot reminders will appear here.</span></div></section>
}
else
{
<section class="card">
    <div class="task-section-heading"><div><p class="eyebrow">Saved tasks</p><h2>@Model.Status financial tasks</h2></div><span class="task-count-badge">@Model.Reminders.Count</span></div>
    <div class="financial-task-list">
    @foreach (var reminder in Model.Reminders)
    {
        var priority = reminder.IsOverdue ? "danger" : reminder.IsDue ? "warning" : "neutral";
        <article class="financial-task-row priority-@priority" id="reminder-@reminder.Id">
            <div class="financial-task-main">
                <span class="financial-task-icon"><i data-lucide="@(reminder.ReservePotId.HasValue ? "piggy-bank" : "calendar-check")"></i></span>
                <div>
                    <div class="task-card-meta"><b>@(reminder.IsSystemGenerated ? "Automatic" : "Manual")</b><small>@reminder.ReminderType</small><small>Due @reminder.EffectiveDueDate.ToString("dd MMM yyyy")</small></div>
                    <h3>@reminder.Title</h3>
                    @if (!string.IsNullOrWhiteSpace(reminder.PotName)){<p class="eyebrow">@reminder.PotName</p>}
                    @if (!string.IsNullOrWhiteSpace(reminder.Description)){<p class="muted">@reminder.Description</p>}
                </div>
            </div>
            @if (canEdit)
            {
            <div class="reminder-actions">
                @if (reminder.Status == "Open")
                {
                    <form asp-action="Complete" method="post">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@reminder.Id"/><button class="primary">Complete</button></form>
                    <form asp-action="Snooze" method="post" class="snooze-form">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@reminder.Id"/><input type="date" name="snoozedUntil" value="@DateTime.Today.AddDays(7).ToString("yyyy-MM-dd")" min="@DateTime.Today.ToString("yyyy-MM-dd")"/><button class="secondary">Snooze</button></form>
                    <form asp-action="Dismiss" method="post">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@reminder.Id"/><button class="danger-inline">Dismiss</button></form>
                }
                else
                {
                    <form asp-action="Reopen" method="post">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@reminder.Id"/><button class="secondary">Reopen</button></form>
                }
            </div>
            }
        </article>
    }
    </div>
</section>
}
