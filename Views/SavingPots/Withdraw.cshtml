@model FinanceManagerAspNet.Models.ReservePotWithdrawalViewModel
@using System.Globalization
@{ ViewData["Title"] = "Withdraw from pot"; var gb = CultureInfo.GetCultureInfo("en-GB"); }
<section class="page-header"><div><p class="eyebrow">Household Reserve</p><h1>Withdraw from @Model.PotName</h1><p class="muted">Record a withdrawal without changing the pot's normal monthly contribution.</p></div><a class="fm-action-button fm-action-secondary" asp-action="Index" asp-fragment="pot-@Model.PotId">Cancel</a></section>
@if (TempData["Error"] is string error){<div class="alert error">@error</div>}
<section class="summary-grid"><article><p class="eyebrow">Current balance</p><strong>@Model.CurrentBalance.ToString("C", gb)</strong></article><article><p class="eyebrow">Result after withdrawal</p><strong id="resultingBalance">@Model.ResultingBalance.ToString("C", gb)</strong></article></section>
<section class="card">
<form asp-action="Withdraw" method="post" class="account-form" data-confirm="Confirm this withdrawal?">
@Html.AntiForgeryToken()
<input type="hidden" asp-for="PotId"/><input type="hidden" asp-for="PotName"/><input type="hidden" asp-for="CurrentBalance"/><input type="hidden" asp-for="OperationKey"/>
<label>Withdrawal amount<input asp-for="Amount" type="number" min="0.01" step="0.01" required id="withdrawalAmount"/></label>
<label>Withdrawal date<input asp-for="WithdrawalDate" type="date" max="@DateTime.Today.ToString("yyyy-MM-dd")" required/></label>
<label>Reason<textarea asp-for="Reason" rows="4" required placeholder="Why is money being taken from this pot?"></textarea></label>
<div class="alert warning" id="negativeWarning" hidden>This withdrawal will take the pot below £0. The monthly contribution will remain unchanged and extra contributions can restore it.</div>
<button class="danger-inline" type="submit">Confirm withdrawal</button>
</form></section>
<script>
(() => { const input=document.getElementById('withdrawalAmount'); const result=document.getElementById('resultingBalance'); const warning=document.getElementById('negativeWarning'); const current=@Model.CurrentBalance.ToString(CultureInfo.InvariantCulture); const fmt=new Intl.NumberFormat('en-GB',{style:'currency',currency:'GBP'}); function update(){const amount=Number(input.value||0); const next=current-amount; result.textContent=fmt.format(next); warning.hidden=next>=0;} input.addEventListener('input',update); update(); })();
</script>
