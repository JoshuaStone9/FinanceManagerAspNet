16px;background:rgba(255,255,255,.04);cursor:pointer}.source-option.selected{border-color:rgba(56,189,248,.55);background:rgba(56,189,248,.08)}.source-option input{margin-top:.25rem}.source-option strong,.source-option small{display:block}.source-option small{color:var(--muted);margin-top:.25rem}.savings-control-grid{margin-top:1rem}.compact-form{grid-template-columns:repeat(auto-fit,minmax(220px,1fr));margin-top:1rem}.schedule-list{display:grid;gap:.6rem;margin-top:1rem}.schedule-list>div{display:grid;grid-template-columns:1fr auto;gap:.5rem;align-items:center;padding:.7rem;border:1px solid var(--line);border-radius:12px;background:rgba(255,255,255,.04)}.schedule-list small{display:block;color:var(--muted)}.link-danger{background:transparent;border:0;color:#fb7185;font-weight:800;cursor:pointer}.forecast-form{display:grid;grid-template-columns:repeat(3,minmax(110px,1fr));gap:.75rem;align-items:end}.forecast-form label{display:grid;gap:.35rem}.forecast-centre-card{margin-top:1rem}.forecast-summary{margin-top:1rem}.forecast-breakdown{margin-top:1rem}.forecast-pot-list{display:grid;gap:.6rem;margin-top:1rem}.forecast-pot-list>div{display:grid;grid-template-columns:1.3fr 1.1fr 1fr auto;gap:.75rem;align-items:center;padding:.75rem;border:1px solid var(--line);border-radius:12px;background:rgba(255,255,255,.04)}.advice-popups{display:grid;gap:.7rem;margin-top:1rem}.advice-popup{padding:.85rem 1rem;border:1px solid var(--line);border-radius:14px;background:rgba(255,255,255,.04)}.advice-popup.warning{border-color:rgba(251,191,36,.5)}.advice-popup.info{border-color:rgba(56,189,248,.45)}.advice-popup summary{cursor:pointer;font-weight:800}.advice-popup p{margin:.5rem 0 0;color:var(--muted)}@@media(max-width:900px){.savings-hero,.section-head{display:block}.pot-forecast-grid{grid-template-columns:1fr}.timeline div{grid-template-columns:1fr}.planner-form{grid-template-columns:1fr!important}.forecast-form,.forecast-pot-list>div{grid-template-columns:1fr}.forecast-form{margin-top:1rem}}
</style>
<script>
(function(){
    function refreshContributionFields(){
        document.querySelectorAll('.contribution-mode-select').forEach(function(select){
            var form = select.closest('form');
            if(!form) return;
            var manual = form.querySelector('.manual-contribution-field');
            if(!manual) return;
            manual.style.display = select.value === 'Manual contribution' ? '' : 'none';
        });
    }
    document.addEventListener('change', function(e){
        if(e.target && e.target.classList.contains('contribution-mode-select')) refreshContributionFields();
    });
    refreshContributionFields();
})();
</script>

