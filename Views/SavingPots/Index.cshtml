@model FinanceManagerAspNet.Models.HouseholdReserveViewModel
@using System.Globalization
@{ ViewData["Title"] = "Household Reserve"; var gb = CultureInfo.GetCultureInfo("en-GB"); var canEdit = User.Identity?.IsAuthenticated == true; var currentMonth = DateTime.Today.ToString("MMMM yyyy"); }
<section class="hero card"><div><p class="eyebrow">One physical fund, clear virtual allocations</p><h1>Household Reserve</h1><p class="muted">Dashboard reserve allocations automatically increase the matching pot and now update its monthly funding history.</p></div><div><a class="secondary" asp-controller="Events" asp-action="Index">Events</a></div></section>
<section class="grid cards-4">
<article class="card"><p class="eyebrow">Physical balance</p><h2>@Model.Reserve.Balance.ToString("C", gb)</h2><p>@Model.Reserve.Provider</p></article>
<article class="card"><p class="eyebrow">Virtual allocations</p><h2>@Model.TotalAllocated.ToString("C", gb)</h2></article>
<article class="card"><p class="eyebrow">Unallocated</p><h2 class="@(Model.IsOverAllocated ? "bad" : "good")">@Model.UnallocatedBalance.ToString("C", gb)</h2></article>
<article class="card"><p class="eyebrow">Estimated monthly interest</p><h2>@Model.EstimatedMonthlyInterest.ToString("C", gb)</h2><p>@Model.Reserve.InterestRate.ToString("0.##")% AER estimate.</p></article>
</section>

@{ var activeSummaries = Model.Pots.Where(x => x.IsActive).Select(x => Model.FundingSummaries.GetValueOrDefault(x.Id)).Where(x => x is not null).ToList(); var attention = activeSummaries.Count(x => x!.CurrentStatus is "Overdue" or "Missed" or "Partially funded"); var expectedThisMonth = activeSummaries.Sum(x => x!.CurrentMonthExpected); var actualThisMonth = activeSummaries.Sum(x => x!.CurrentMonthActual); }
<section class="card" id="monthly-checklist"><div class="section-head"><div><p class="eyebrow">Monthly funding checklist</p><h2>@currentMonth</h2><p class="muted">@attention pot@(attention == 1 ? "" : "s") need attention. @actualThisMonth.ToString("C", gb) of @expectedThisMonth.ToString("C", gb) funded.</p></div></div>
<div class="grid cards-4 compact-grid">
@foreach (var pot in Model.Pots.Where(x => x.IsActive))
{
    var summary = Model.FundingSummaries.GetValueOrDefault(pot.Id);
    if (summary is null) continue;
    <article><p class="eyebrow">@pot.Name</p><strong class="@summary.StatusCssClass">@summary.CurrentStatus</strong><p class="muted">@summary.CurrentMonthActual.ToString("C", gb) / @summary.CurrentMonthExpected.ToString("C", gb) this month</p><a href="#pot-@pot.Id">Review</a></article>
}
</div></section>

@{ var availableForRecovery = Math.Max(0, Model.UnallocatedBalance); var remainingRecovery = availableForRecovery; var recommendations = new List<(FinanceManagerAspNet.Models.ReservePot Pot, decimal Amount)>(); foreach (var candidate in Model.Pots.Where(x => x.IsActive).OrderBy(x => x.Priority)) { var needed = Model.FundingSummaries.GetValueOrDefault(candidate.Id)?.OutstandingRecovery ?? 0; var amount = Math.Min(needed, remainingRecovery); if (amount > 0) { recommendations.Add((candidate, amount)); remainingRecovery -= amount; } if (remainingRecovery <= 0) break; } }
@if (recommendations.Count > 0)
{
<section class="card"><div class="section-head"><div><p class="eyebrow">Recommended recovery allocation</p><h2>Use available excess to catch up</h2><p class="muted">Based on pot priority and outstanding missed funding. This is a recommendation only and does not move money automatically.</p></div></div><div class="grid cards-4 compact-grid">@foreach(var item in recommendations){<article><p class="eyebrow">@item.Pot.Name</p><strong>@item.Amount.ToString("C", gb)</strong><p class="muted">Suggested catch-up contribution</p></article>}</div></section>
}

@if (canEdit)
{
<section class="card" id="reserve-account"><p class="eyebrow">Physical account</p><h2>Edit reserve account</h2><form asp-action="SaveReserve" method="post" class="account-form">@Html.AntiForgeryToken()<label>Balance<input name="balance" type="number" min="0" step="0.01" value="@Model.Reserve.Balance"/></label><label>Interest rate %<input name="interestRate" type="number" min="0" step="0.01" value="@Model.Reserve.InterestRate"/></label><label>Provider<input name="provider" value="@Model.Reserve.Provider"/></label><button class="primary">Save reserve</button></form></section>
}

<div id="allocations"></div>
@if (Model.Pots.Count == 0)
{
<section class="card"><h2>No virtual allocations yet</h2><p class="muted">Add a pot below, or create a Household reserve allocation on the Dashboard.</p></section>
}
else
{
@foreach (var pot in Model.Pots)
{
    var summary = Model.FundingSummaries.GetValueOrDefault(pot.Id) ?? new FinanceManagerAspNet.Models.ReservePotFundingSummary { PotId = pot.Id };
<section class="card" id="pot-@pot.Id"><div class="section-head"><div><p class="eyebrow">Virtual allocation</p><h2>@pot.Name</h2><p class="muted">@pot.Notes</p></div><div><a class="secondary" asp-controller="Events" asp-action="Index" asp-route-potId="@pot.Id">Events</a></div></div>
<section class="grid cards-4 compact-grid">
<article><p class="eyebrow">Allocated</p><strong>@pot.AllocatedAmount.ToString("C", gb)</strong></article>
<article><p class="eyebrow">Funding status</p><strong class="@summary.StatusCssClass">@summary.CurrentStatus</strong><p class="muted">@summary.CurrentMonthActual.ToString("C", gb) of @summary.CurrentMonthExpected.ToString("C", gb) this month.</p></article>
<article><p class="eyebrow">Outstanding recovery</p><strong class="@(summary.OutstandingRecovery > 0 ? "bad" : "good")">@summary.OutstandingRecovery.ToString("C", gb)</strong><p class="muted">Later excess funding automatically reduces this.</p></article>
<article><p class="eyebrow">Expected balance today</p><strong>@summary.ExpectedBalanceToday.ToString("C", gb)</strong><p class="muted">Actual balance: @pot.AllocatedAmount.ToString("C", gb)</p></article>
<article><p class="eyebrow">Intended funding</p><strong>@pot.IntendedMonthlyContribution.ToString("C", gb)</strong><p class="muted">@pot.FundingFrequency@(pot.ExpectedFundingDay.HasValue ? $" · expected day {pot.ExpectedFundingDay}" : "")</p></article>
<article><p class="eyebrow">Missed / partial months</p><strong>@summary.MissedMonths / @summary.PartiallyFundedMonths</strong><p class="muted">Tracked since @pot.FundingPlanStartDate.ToString("dd MMM yyyy").</p></article>
<article><p class="eyebrow">Target</p><strong>@(pot.TargetAmount?.ToString("C", gb) ?? "None")</strong></article>
<article><p class="eyebrow">Due</p><strong>@(pot.DueDate?.ToString("MMM yyyy") ?? "None")</strong></article>
@if (pot.TargetAmount.HasValue && pot.DueDate.HasValue)
{
<article><p class="eyebrow">Projected by due date</p><strong>@summary.ProjectedBalanceByDueDate.ToString("C", gb)</strong><p class="muted">Using intended funding.</p></article>
<article><p class="eyebrow">Projected shortfall</p><strong class="@((summary.ProjectedShortfall ?? 0) > 0 ? "bad" : "good")">@((summary.ProjectedShortfall ?? 0).ToString("C", gb))</strong></article>
<article><p class="eyebrow">Required monthly</p><strong>@(summary.RequiredMonthlyContribution?.ToString("C", gb) ?? "—")</strong></article>
<article><p class="eyebrow">Additional monthly needed</p><strong class="@((summary.AdditionalMonthlyContributionRequired ?? 0) > 0 ? "bad" : "good")">@(summary.AdditionalMonthlyContributionRequired?.ToString("C", gb) ?? "—")</strong></article>
}
</section>
@if (canEdit)
{
<form asp-action="SavePot" method="post" class="account-form edit-panel">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@pot.Id"/><label>Name<input name="name" value="@pot.Name" required/></label><label>Allocated now<input name="allocatedAmount" type="number" min="0" step="0.01" value="@pot.AllocatedAmount"/></label><label>Average monthly contribution<input name="defaultMonthlyContribution" type="number" min="0" step="0.01" value="@pot.DefaultMonthlyContribution" readonly/><span class="muted">Automatically calculated from dashboard contributions.</span></label><label>Intended contribution<input name="intendedMonthlyContribution" type="number" min="0" step="0.01" value="@pot.IntendedMonthlyContribution"/><span class="muted">What you normally plan to add.</span></label><label>Funding frequency<select name="fundingFrequency"><option selected="@(pot.FundingFrequency == "Monthly")">Monthly</option><option selected="@(pot.FundingFrequency == "Weekly")">Weekly</option><option selected="@(pot.FundingFrequency == "Irregular")">Irregular</option></select></label><label>Expected funding day<input name="expectedFundingDay" type="number" min="1" max="31" value="@pot.ExpectedFundingDay"/><span class="muted">Optional day of the month, such as payday.</span></label><label>Funding plan start date<input name="fundingPlanStartDate" type="date" value="@pot.FundingPlanStartDate.ToString("yyyy-MM-dd")"/><span class="muted">Existing pots use their first contribution, falling back to 1 January 2026.</span></label><label class="checkbox-inline"><input name="carryForwardShortfalls" type="checkbox" value="true" checked="@pot.CarryForwardShortfalls"/> Carry missed funding forward</label><label class="checkbox-inline"><input name="carryExcessForward" type="checkbox" value="true" checked="@pot.CarryExcessForward"/> Carry genuine excess into future months</label><p class="muted">When enabled, money left after this month and any recovery can satisfy future planned contributions. It will still be shown separately from new dashboard payments.</p><label>Temporarily pause funding until<input name="fundingPausedUntil" type="date" value="@pot.FundingPausedUntil?.ToString("yyyy-MM-dd")"/><span class="muted">The allocation remains active and can still receive voluntary contributions, but no scheduled funding is expected during the pause.</span></label><label>Pause reason<input name="fundingPauseReason" value="@pot.FundingPauseReason"/></label><label>Optional target<input name="targetAmount" type="number" min="0" step="0.01" value="@pot.TargetAmount"/></label><label>Optional due date<input name="dueDate" type="date" value="@pot.DueDate?.ToString("yyyy-MM-dd")"/></label><label>Priority<input name="priority" type="number" min="1" value="@pot.Priority"/></label><label class="checkbox-inline"><input name="isActive" type="checkbox" value="true" checked="@pot.IsActive"/> Active allocation</label><p class="muted">Untick only when this pot is stopped or archived. Use the pause setting for a temporary break.</p><label>Notes<input name="notes" value="@pot.Notes"/></label><button class="primary">Save allocation</button></form>
<details class="edit-panel"><summary>Recalculate funding history</summary><form asp-action="RebuildHistory" method="post" class="account-form">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@pot.Id"/><label>Start from<select name="startMode"><option value="FirstContribution">Current imported baseline</option><option value="January2026">1 January 2026</option><option value="Custom">Custom date</option></select></label><label>Custom date<input name="customStartDate" type="date" value="@pot.FundingPlanStartDate.ToString("yyyy-MM-dd")"/></label><button class="secondary">Rebuild history</button></form></details>
<form asp-action="DeletePot" method="post" data-confirm="Delete this virtual allocation?">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@pot.Id"/><button class="danger-inline">Delete</button></form>
}
<details class="edit-panel" open><summary>Funding history</summary><div class="table-wrap"><table><thead><tr><th>Month</th><th>Status</th><th>Expected</th><th>Actual</th><th>Difference</th></tr></thead><tbody>@foreach (var month in summary.Months.Take(18)){<tr><td>@month.MonthLabel</td><td>@month.Status</td><td>@month.ExpectedAmount.ToString("C", gb)</td><td>@month.ActualAmount.ToString("C", gb)</td><td class="@(month.Difference < 0 ? "bad" : month.Difference > 0 ? "good" : "")">@month.Difference.ToString("C", gb)</td></tr>}</tbody></table></div></details>
</section>
}
}
@if (canEdit)
{
<section class="card" id="new-allocation"><p class="eyebrow">New allocation</p><h2>Add virtual pot</h2><form asp-action="SavePot" method="post" class="account-form">@Html.AntiForgeryToken()<input type="hidden" name="id" value="0"/><label>Name<input name="name" required placeholder="e.g. Car insurance"/></label><label>Allocated now<input name="allocatedAmount" type="number" min="0" step="0.01" value="0"/></label><label>Average monthly contribution<input name="defaultMonthlyContribution" type="number" min="0" step="0.01" value="0" readonly/></label><label>Intended contribution<input name="intendedMonthlyContribution" type="number" min="0" step="0.01" value="0"/></label><label>Funding frequency<select name="fundingFrequency"><option selected>Monthly</option><option>Weekly</option><option>Irregular</option></select></label><label>Expected funding day<input name="expectedFundingDay" type="number" min="1" max="31"/></label><label>Funding plan start date<input name="fundingPlanStartDate" type="date" value="@DateTime.Today.ToString("yyyy-MM-dd")"/></label><label class="checkbox-inline"><input name="carryForwardShortfalls" type="checkbox" value="true" checked/> Carry missed funding forward</label><label class="checkbox-inline"><input name="carryExcessForward" type="checkbox" value="true"/> Carry genuine excess into future months</label><p class="muted">Optional. Future months may use credit remaining after the current month and recovery.</p><label>Temporarily pause funding until<input name="fundingPausedUntil" type="date"/><span class="muted">The pot stays active and voluntary contributions are still allowed.</span></label><label>Pause reason<input name="fundingPauseReason"/></label><label>Optional target<input name="targetAmount" type="number" min="0" step="0.01"/></label><label>Optional due date<input name="dueDate" type="date"/></label><label>Priority<input name="priority" type="number" min="1" value="10"/></label><input type="hidden" name="isActive" value="true"/><label>Notes<input name="notes"/></label><button class="primary">Add allocation</button></form></section>
}
