@model FinanceManagerAspNet.Models.HouseholdReserveViewModel
@using System.Globalization
@{
    ViewData["Title"] = "Money Pots";
    var gb = CultureInfo.GetCultureInfo("en-GB");
    var canEdit = User.Identity?.IsAuthenticated == true;
}

<section class="hero card money-pots-hero">
    <div>
        <p class="eyebrow">Your savings, organised clearly</p>
        <h1>Money Pots</h1>
        <p class="money-pots-total">@Model.TotalAllocated.ToString("C", gb) saved across @Model.ActivePotCount active pot@(Model.ActivePotCount == 1 ? "" : "s")</p>
        <p class="muted">Set optional goals, record real contributions and let Finance Manager calculate when each target could be reached.</p>
    </div>
    <div class="button-row">
        @if (canEdit) { <a class="fm-action-button fm-action-primary" href="#new-allocation">Create money pot</a> }
        <a class="fm-action-button fm-action-secondary" asp-controller="MonthlyMoney" asp-action="MoneyPots">Add contribution</a>
    </div>
</section>

<section class="grid cards-4">
    <article class="card"><p class="eyebrow">Saved in pots</p><h2>@Model.TotalAllocated.ToString("C", gb)</h2></article>
    <article class="card"><p class="eyebrow">Active pots</p><h2>@Model.ActivePotCount</h2></article>
    <article class="card"><p class="eyebrow">Remaining to targets</p><h2>@Model.RemainingToTargets.ToString("C", gb)</h2></article>
    <article class="card"><p class="eyebrow">Still available</p><h2 class="@(Model.RemainingToAllocate > 0 ? "good" : Model.IsOverAllocated ? "bad" : "")">@Model.RemainingToAllocate.ToString("C", gb)</h2><p class="muted">Above the protected reserve and not already assigned.</p></article>
</section>

<section class="card" id="reserve-accounts">
    <div class="section-head"><div><p class="eyebrow">Backing accounts</p><h2>Accounts holding your Money Pots</h2></div>
        @if (!Model.ShowAccountSelector && canEdit) { <a class="button secondary" asp-action="Index" asp-route-reselect="true" asp-fragment="reserve-accounts">Change accounts</a> }
    </div>
    @if (Model.ShowAccountSelector)
    {
        <form asp-action="SaveReserveAccountSelection" method="post" class="account-form">@Html.AntiForgeryToken()
            <div class="grid cards-4 compact-grid">
                @foreach (var account in Model.AccountSummary.AvailableAccounts)
                {
                    <label class="reserve-account-option"><input type="checkbox" name="selectedAccountIds" value="@account.Id" checked="@account.IsSelected"/><span><strong>@account.Name</strong><small>@account.Balance.ToString("C", gb) · @account.InterestRate.ToString("0.##")% AER</small></span></label>
                }
            </div><button class="primary">Save backing accounts</button>
        </form>
    }
    else
    {
        <div class="grid cards-4 compact-grid">@foreach (var account in Model.AccountSummary.SelectedAccounts) { <article><p class="eyebrow">@account.Name</p><strong>@account.Balance.ToString("C", gb)</strong><p class="muted">@account.InterestRate.ToString("0.##")% AER</p></article> }</div>

        <div class="grid cards-4 compact-grid reserve-position-grid">
            <article><p class="eyebrow">Current reserve</p><strong>@Model.CurrentReserve.ToString("C", gb)</strong><p class="muted">Total held across the selected backing accounts.</p></article>
            <article><p class="eyebrow">Protected reserve</p><strong>@Model.ProtectedReserve.ToString("C", gb)</strong><p class="muted">Controlled from Settings → Finance.</p></article>
            <article><p class="eyebrow">@(Model.ReserveShortfall > 0 ? "Reserve shortfall" : "Available above reserve")</p><strong class="@(Model.ReserveShortfall > 0 ? "bad" : "good")">@((Model.ReserveShortfall > 0 ? Model.ReserveShortfall : Model.AvailableAboveProtectedReserve).ToString("C", gb))</strong><p class="muted">@(Model.ReserveShortfall > 0 ? "Still needed before the protected reserve is fully covered." : "Can be assigned without using the protected reserve.")</p></article>
            <article><p class="eyebrow">Allocated to pots</p><strong>@Model.TotalAllocated.ToString("C", gb)</strong><p class="muted">Money already earmarked for active Money Pots.</p></article>
        </div>

        @if (Model.IsOverAllocated)
        {
            <div class="notice warning reserve-position-warning">
                <strong>@Model.AllocatedBeyondAvailable.ToString("C", gb) is allocated beyond the freely available reserve.</strong>
                <span>Your Money Pots are valid earmarks, but the selected accounts have not yet covered the protected reserve plus those allocations.</span>
            </div>
        }
        else if (Model.RemainingToAllocate > 0)
        {
            <div class="notice success reserve-position-warning">
                <strong>@Model.RemainingToAllocate.ToString("C", gb) remains available.</strong>
                <span>This is above the protected reserve and has not yet been assigned to a Money Pot.</span>
            </div>
        }
    }
</section>

@if (Model.Pots.Count == 0)
{
    <section class="card money-pots-empty"><i data-lucide="piggy-bank"></i><h2>No Money Pots yet</h2><p class="muted">Create a pot, then add contributions from the monthly Money Pots workspace.</p></section>
}
else
{
    <section class="fm-pot-grid" id="allocations">
    @foreach (var pot in Model.Pots.OrderByDescending(x => x.IsActive).ThenBy(x => x.Name))
    {
        var summary = Model.FundingSummaries.GetValueOrDefault(pot.Id) ?? new FinanceManagerAspNet.Models.ReservePotFundingSummary { PotId = pot.Id };
        var progress = pot.TargetAmount.HasValue && pot.TargetAmount.Value > 0 ? Math.Min(100m, Math.Max(0m, pot.AllocatedAmount / pot.TargetAmount.Value * 100m)) : 0m;
        <article class="card fm-pot-card @(pot.IsActive ? "" : "is-paused")" id="pot-@pot.Id">
            <div class="fm-pot-card-head">
                <div><p class="eyebrow">@(pot.IsActive ? "Money pot" : "Paused pot")</p><h2>@pot.Name</h2></div>
                <span class="fm-status-pill @(pot.IsActive ? "good" : "warn")">@(pot.IsActive ? summary.CurrentStatus : "Paused")</span>
            </div>

            <div class="fm-pot-balance"><span>Current balance</span><strong>@pot.AllocatedAmount.ToString("C", gb)</strong></div>
            @if (pot.TargetAmount.HasValue)
            {
                <div class="fm-pot-progress" role="progressbar" aria-valuenow="@progress.ToString("0")" aria-valuemin="0" aria-valuemax="100"><span style="width:@progress.ToString("0.##", CultureInfo.InvariantCulture)%"></span></div>
                <p class="muted">@progress.ToString("0")% of @pot.TargetAmount.Value.ToString("C", gb)</p>
            }

            <div class="grid cards-4 compact-grid fm-pot-stats">
                <article><p class="eyebrow">Target</p><strong>@(pot.TargetAmount?.ToString("C", gb) ?? "No target")</strong></article>
                <article><p class="eyebrow">Recent monthly average</p><strong>@summary.RecentMonthlyContribution.ToString("C", gb)</strong><p class="muted">Calculated from real contribution history.</p></article>
                <article><p class="eyebrow">Estimated completion</p><strong>@(summary.EstimatedCompletionDate?.ToString("MMM yyyy") ?? (pot.TargetAmount.HasValue ? "Not enough history" : "No target"))</strong></article>
                <article><p class="eyebrow">Date needed by</p><strong>@(pot.DueDate?.ToString("dd MMM yyyy") ?? "Not set")</strong></article>
            </div>

            @if (pot.TargetAmount.HasValue)
            {
                <div class="fm-pot-forecast @(pot.DueDate.HasValue && summary.EstimatedCompletionDate.HasValue && summary.EstimatedCompletionDate.Value > pot.DueDate.Value ? "is-behind" : "is-on-track")">
                    <i data-lucide="calendar-clock"></i>
                    <div><strong>@pot.GoalTimingLabel</strong><span>Forecast updates automatically whenever contributions change.</span></div>
                </div>
            }

            <div class="pot-action-row">
                <a class="pot-action-button pot-action-primary" asp-controller="MonthlyMoney" asp-action="MoneyPots">Add contribution</a>
                @if (canEdit)
                {
                    <form asp-action="TogglePause" method="post">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@pot.Id"/><button class="pot-action-button @(pot.IsActive ? "pot-action-pause" : "pot-action-success")" type="submit">@(pot.IsActive ? "Pause pot" : "Resume pot")</button></form>
                    <a class="pot-action-button pot-action-danger" asp-action="Withdraw" asp-route-id="@pot.Id">Withdraw</a>
                }
                <a class="pot-action-button pot-action-secondary" asp-controller="Events" asp-action="Index" asp-route-potId="@pot.Id">View activity</a>
            </div>

            @if (canEdit)
            {
                <details class="edit-panel"><summary>Edit pot details</summary>
                    <form asp-action="SavePot" method="post" class="account-form fm-pot-simple-form">@Html.AntiForgeryToken()
                        <input type="hidden" name="id" value="@pot.Id"/>
                        <label>Name<input name="name" value="@pot.Name" required/></label>
                        <label>Target <span class="muted">(optional)</span><input name="targetAmount" type="number" min="0" step="0.01" value="@pot.TargetAmount"/></label>
                        <label>Date needed by <span class="muted">(optional)</span><input name="dueDate" type="date" value="@pot.DueDate?.ToString("yyyy-MM-dd")"/></label>
                        <label class="field full">Notes<textarea name="notes" rows="3">@pot.Notes</textarea></label>
                        <p class="muted field full">Current balance and contribution averages are calculated automatically. Estimated completion is based on your real contribution history.</p>
                        <button class="primary">Save Money Pot</button>
                    </form>
                </details>
                <form asp-action="DeletePot" method="post" data-confirm="Delete this Money Pot?">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@pot.Id"/><button class="danger-inline">Delete pot</button></form>
            }
        </article>
    }
    </section>
}

@if (canEdit)
{
<section class="card" id="new-allocation">
    <p class="eyebrow">New Money Pot</p><h2>Create a Money Pot</h2>
    <p class="muted">Start at £0, add an optional goal and record contributions whenever you choose.</p>
    <form asp-action="SavePot" method="post" class="account-form fm-pot-simple-form">@Html.AntiForgeryToken()
        <input type="hidden" name="id" value="0"/>
        <label>Name<input name="name" required placeholder="e.g. Florida holiday"/></label>
        <label>Target <span class="muted">(optional)</span><input name="targetAmount" type="number" min="0" step="0.01"/></label>
        <label>Date needed by <span class="muted">(optional)</span><input name="dueDate" type="date" min="@DateTime.Today.ToString("yyyy-MM-dd")"/></label>
        <label class="field full">Notes<textarea name="notes" rows="3"></textarea></label>
        <button class="primary">Create Money Pot</button>
    </form>
</section>
}
