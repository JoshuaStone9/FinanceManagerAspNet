@model FinanceManagerAspNet.Models.StatementWorkspaceViewModel
@{
 ViewData["Title"] = "Statement Workspace";
 var month = new DateTime(Model.Year, Model.Month, 1);
 var unresolved = Model.Transactions.Where(x => x.Status == "Unmatched").ToList();
}
<section class="fm-page-header">
 <div><p class="fm-eyebrow">@Model.Provider · @month.ToString("MMMM yyyy")</p><h1>@Model.AccountName</h1><p>Review every statement line and connect it to the entry recorded in Finance Manager.</p></div>
 <a class="fm-button" asp-action="Index" asp-route-year="@Model.Year" asp-route-month="@Model.Month">Back to accounts</a>
</section>

<div class="statement-summary-grid">
 <div class="fm-panel"><span>Total lines</span><strong>@Model.Transactions.Count</strong></div>
 <div class="fm-panel"><span>Matched</span><strong>@Model.MatchedCount</strong></div>
 <div class="fm-panel"><span>Needs review</span><strong>@Model.UnmatchedCount</strong></div>
 <div class="fm-panel"><span>Ignored</span><strong>@Model.IgnoredCount</strong></div>
</div>

<div class="statement-workspace-grid">
 <div class="statement-main-column">
  @if (Model.ImportPreview.Count > 0 && !Model.IsCompleted)
  {
   <section class="fm-panel statement-import-preview">
    <div class="statement-section-heading"><div><p class="fm-eyebrow">IMPORT PREVIEW</p><h2>Confirm extracted transactions</h2><p>Review the extracted lines before they are added. Previously imported duplicates are disabled.</p></div><span class="statement-status is-review">@Model.ImportPreview.Count extracted</span></div>
    <form asp-action="Import" method="post">
     @Html.AntiForgeryToken()
     <input type="hidden" name="statementId" value="@Model.StatementId" />
     <div class="statement-preview-list">
      @foreach (var row in Model.ImportPreview)
      {
       <label class="statement-preview-row @(row.IsDuplicate ? "is-duplicate" : "")">
        <input type="checkbox" name="selectedRows" value="@row.Id" checked="@(!row.IsDuplicate)" disabled="@row.IsDuplicate" />
        <span><strong>@row.Description</strong><small>@row.Date.ToString("dd MMM yyyy") · @(row.Direction == "In" ? "Money in" : "Money out")</small></span>
        <strong>@(row.Direction == "In" ? "+" : "-")@row.Amount.ToString("C")</strong>
        @if (row.IsDuplicate) { <span class="statement-status">Duplicate</span> }
       </label>
      }
     </div>
     <button class="fm-button fm-button-primary" type="submit" disabled="@Model.ImportPreview.All(x => x.IsDuplicate)">Import selected transactions</button>
    </form>
   </section>
  }
  <section class="fm-panel">
   <div class="statement-section-heading"><div><p class="fm-eyebrow">STATEMENT LINES</p><h2>Review transactions</h2></div><span class="statement-status">@Model.Status</span></div>
   @if (Model.Transactions.Count == 0) { <div class="fm-empty-state"><p>No transactions have been imported yet. Upload a PDF or add a statement line manually.</p></div> }
   else
   {
    <div class="statement-transaction-list">
    @foreach (var row in Model.Transactions)
    {
      <article class="statement-transaction-row status-@row.Status.ToLowerInvariant()">
       <div class="statement-transaction-copy"><strong>@row.Description</strong><span>@row.TransactionDate.ToString("dd MMM yyyy") · @(row.Direction == "In" ? "Money in" : "Money out")</span>@if(!string.IsNullOrWhiteSpace(row.MatchLabel)){<small>Matched to @row.MatchLabel</small>}@if(!string.IsNullOrWhiteSpace(row.Notes)){<small>@row.Notes</small>}</div>
       <strong class="statement-amount">@(row.Direction == "In" ? "+" : "-")@row.Amount.ToString("C")</strong>
       <span class="statement-status">@row.Status</span>
       <div class="statement-actions">
       @if(!Model.IsCompleted && row.Status == "Unmatched")
       {
        var suggestions = StatementMatchScorer.Rank(row, Model.Candidates);
        <form asp-action="Match" method="post" class="statement-match-form">@Html.AntiForgeryToken()<input type="hidden" name="statementId" value="@Model.StatementId"/><input type="hidden" name="transactionId" value="@row.Id"/><select name="candidateKey" required><option value="">Choose recorded entry...</option>@if(suggestions.Count > 0){<optgroup label="Suggested matches">@foreach(var suggestion in suggestions){<option value="@suggestion.Candidate.Key">@suggestion.Score% · @suggestion.Candidate.Label</option>}</optgroup>}<optgroup label="All available entries">@foreach(var candidate in Model.Candidates.Where(x => x.Direction == row.Direction && suggestions.All(s => s.Candidate.Key != x.Key))){<option value="@candidate.Key">@candidate.Label</option>}</optgroup></select><button class="fm-button fm-button-primary" type="submit">Match</button></form>
        <form asp-action="Ignore" method="post">@Html.AntiForgeryToken()<input type="hidden" name="statementId" value="@Model.StatementId"/><input type="hidden" name="transactionId" value="@row.Id"/><input type="hidden" name="notes" value="Ignored during manual review"/><button class="fm-button" type="submit">Ignore</button></form>
        <form asp-action="DeleteTransaction" method="post" onsubmit="return confirm('Remove this statement transaction?');">@Html.AntiForgeryToken()<input type="hidden" name="statementId" value="@Model.StatementId"/><input type="hidden" name="transactionId" value="@row.Id"/><button class="fm-button" type="submit">Delete</button></form>
        <button class="fm-button" type="button" data-open="createStatementEntry-@row.Id">Create missing record</button>
        <div class="modal" id="createStatementEntry-@row.Id"><div class="modal-panel statement-create-modal"><button class="x" type="button" data-close>×</button><p class="fm-eyebrow">NEW FINANCE MANAGER RECORD</p><h2>Create and match</h2><p>Create a record for <strong>@row.Description</strong>. You can replace the bank description with your preferred title.</p><form asp-action="CreateEntry" method="post" class="statement-create-form">@Html.AntiForgeryToken()<input type="hidden" name="statementId" value="@Model.StatementId"/><input type="hidden" name="transactionId" value="@row.Id"/><label>Record title<input type="text" name="title" value="@row.Description" maxlength="150" required/></label><label>Section<select name="source">@if(row.Direction == "In"){<option value="monthly_income_entries">Income</option>}else{<option value="bills">Essential bills</option><option value="everyday_spending">Everyday spending</option><option value="extra_expenses">Extra expenses</option><option value="investments">Investments</option><option value="savings">Money pots / savings</option>}</select></label><div class="statement-create-summary"><span>@row.TransactionDate.ToString("dd MMM yyyy")</span><strong>@(row.Direction == "In" ? "+" : "-")@row.Amount.ToString("C")</strong></div><button class="fm-button fm-button-primary" type="submit">Create record and match</button></form></div></div>
       }
       else if (!Model.IsCompleted)
       {
        <form asp-action="Reopen" method="post">@Html.AntiForgeryToken()<input type="hidden" name="statementId" value="@Model.StatementId"/><input type="hidden" name="transactionId" value="@row.Id"/><button class="fm-button" type="submit">Reopen</button></form>
       }
       </div>
      </article>
    }
    </div>
   }
  </section>
 </div>
 <aside class="statement-side-column">
  @if (!Model.IsCompleted)
  {
  <section class="fm-panel"><p class="fm-eyebrow">PDF STATEMENT</p><h2>Import statement</h2><p>Upload a text-based PDF to extract its transaction lines using the <strong>@Model.StatementParser</strong> parser. You will review every line before importing it.</p>@if(!string.IsNullOrWhiteSpace(Model.OriginalFileName)){<div class="statement-file"><i data-lucide="file-check-2"></i><span><strong>@Model.OriginalFileName</strong><small>Stored securely outside wwwroot</small></span></div>}<form asp-action="Upload" method="post" enctype="multipart/form-data">@Html.AntiForgeryToken()<input type="hidden" name="statementId" value="@Model.StatementId"/><input type="file" name="statementFile" accept="application/pdf,.pdf" required/><button class="fm-button fm-button-primary" type="submit">Upload and extract PDF</button></form></section>
  <section class="fm-panel"><p class="fm-eyebrow">MANUAL ENTRY</p><h2>Add statement line</h2><form asp-action="AddTransaction" method="post" class="statement-entry-form">@Html.AntiForgeryToken()<input type="hidden" name="statementId" value="@Model.StatementId"/><label>Date<input type="date" name="transactionDate" value="@month.ToString("yyyy-MM-dd")" required/></label><label>Description<input type="text" name="description" required/></label><label>Amount<input type="number" name="amount" min="0.01" step="0.01" required/></label><label>Direction<select name="direction"><option value="Out">Money out</option><option value="In">Money in</option></select></label><button class="fm-button fm-button-primary" type="submit">Add transaction</button></form></section>
  <section class="fm-panel"><p class="fm-eyebrow">FINAL REVIEW</p><h2>Complete month</h2><p>@(Model.CanComplete ? "Every transaction is resolved. You can complete this statement." : Model.Transactions.Count == 0 ? "Add at least one statement transaction before completion." : $"Resolve or ignore {Model.UnmatchedCount} transaction(s) before completion.")</p><form asp-action="Complete" method="post">@Html.AntiForgeryToken()<input type="hidden" name="statementId" value="@Model.StatementId"/><button class="fm-button fm-button-primary" type="submit" disabled="@(!Model.CanComplete)">Complete reconciliation</button></form></section>
  }
  else
  {
   <section class="fm-panel"><p class="fm-eyebrow">COMPLETED</p><h2>Reconciliation locked</h2><p>This statement is complete. Reopen it if another line needs reviewing or correcting.</p><form asp-action="ReopenStatement" method="post">@Html.AntiForgeryToken()<input type="hidden" name="statementId" value="@Model.StatementId"/><button class="fm-button" type="submit">Reopen statement</button></form></section>
  }
 </aside>
</div>
