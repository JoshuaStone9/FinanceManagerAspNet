@model FinanceManagerAspNet.Models.FinanceEventsViewModel
@using System.Globalization
@{ ViewData["Title"] = "Events"; var gb = CultureInfo.GetCultureInfo("en-GB"); }
<section class="hero card"><div><p class="eyebrow">Audit timeline</p><h1>Finance Events</h1><p class="muted">A readable history of important manual and automatic actions across Finance Manager.</p></div><a class="secondary" asp-controller="SavingPots" asp-action="Index">Back to Household Reserve</a></section>
<section class="card"><form method="get" class="account-form"><label>Allocation<select name="potId"><option value="">All allocations</option>@foreach(var pot in Model.Pots){<option value="@pot.Id" selected="@(Model.PotId == pot.Id)">@pot.Name</option>}</select></label><label>Event type<input name="eventType" value="@Model.EventType" placeholder="e.g. FundingMissed"/></label><label>From<input type="date" name="from" value="@Model.From?.ToString("yyyy-MM-dd")"/></label><label>To<input type="date" name="to" value="@Model.To?.ToString("yyyy-MM-dd")"/></label><button class="primary">Filter events</button></form></section>
<section class="card"><div class="table-wrap"><table><thead><tr><th>Date and time</th><th>Area</th><th>Event</th><th>Details</th><th>Amount</th><th>Source</th></tr></thead><tbody>@if(Model.Events.Count==0){<tr><td colspan="6" class="muted">No matching events yet.</td></tr>}@foreach(var item in Model.Events){<tr><td>@item.OccurredAt.ToLocalTime().ToString("dd MMM yyyy HH:mm")</td><td>@item.Area</td><td><strong>@item.Title</strong><br/><span class="muted">@item.EventType</span></td><td>@item.Description</td><td>@(item.Amount?.ToString("C", gb) ?? "—")</td><td>@item.Source</td></tr>}</tbody></table></div></section>
