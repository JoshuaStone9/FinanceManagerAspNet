@model FinanceManagerAspNet.Models.DashboardViewModel
@using FinanceManagerAspNet.Models
@using System.Globalization
@{
    ViewData["Title"] = "Dashboard";
    var gb = CultureInfo.GetCultureInfo("en-GB");
    var reserveUnallocated = (decimal)(ViewBag.ReserveUnallocated ?? 0m);
    var journey = Model.Experience.Journey;
    var largestExtra = Model.ExtraExpenses.OrderByDescending(x => x.Amount).FirstOrDefault();
}

<header class="fm-dashboard-hero">
    <div>
        <p class="eyebrow">Finance Manager command centre</p>
        <h1>@(DateTime.Now.Hour < 12 ? "Good morning" : DateTime.Now.Hour < 18 ? "Good afternoon" : "Good evening")</h1>
        <p>See where this month's money has gone, what remains and what needs attention next.</p>
        <time datetime="@DateTime.Today.ToString("yyyy-MM-dd")">@DateTime.Today.ToString("dddd, d MMMM yyyy")</time>
    </div>
    <nav class="fm-dashboard-month" aria-label="Change dashboard month">
        <a class="fm-month-button" asp-route-year="@Model.PreviousMonth.Year" asp-route-month="@Model.PreviousMonth.Month" aria-label="Previous month"><i data-lucide="chevron-left"></i></a>
        <span class="fm-month-label" aria-live="polite">@Model.MonthStart.ToString("MMMM yyyy")</span>
        <a class="fm-month-button" asp-route-year="@Model.NextMonth.Year" asp-route-month="@Model.NextMonth.Month" aria-label="Next month"><i data-lucide="chevron-right"></i></a>
    </nav>
</header>

@if (TempData["CarryMessage"] != null) { <div class="fm-dashboard-notice">@TempData["CarryMessage"]</div> }
@if (TempData["Success"] != null) { <div class="fm-dashboard-notice">@TempData["Success"]</div> }

<section class="fm-dashboard-section" aria-labelledby="overview-title">
    <div class="fm-dashboard-section-head"><div><p class="eyebrow">Financial overview</p><h2 id="overview-title">Your month at a glance</h2></div><span>@Model.Experience.RecordedItemCount recorded items</span></div>
    <div class="fm-metric-grid">
        <article class="fm-metric-card"><span>Available income</span><strong>@Model.EffectiveIncome.ToString("C", gb)</strong><small>@Model.MonthlyIncome.ToString("C", gb) income · @Model.CarryForwardAmount.ToString("C", gb) carry forward</small></article>
        <article class="fm-metric-card"><span>Core spending</span><strong>@((Model.BillsTotal + Model.ExpensesTotal + Model.ExtraExpensesTotal).ToString("C", gb))</strong><small>Bills, everyday and extra expenses</small></article>
        <article class="fm-metric-card"><span>Allocated to the future</span><strong>@Model.Experience.AllocatedToFuture.ToString("C", gb)</strong><small>Investments and Household Reserve</small></article>
        <article class="fm-metric-card @(Model.IsOverBudget ? "is-danger" : "is-positive")"><span>Remaining</span><strong>@Model.RemainingFund.ToString("C", gb)</strong><small>@(Model.IsOverBudget ? "The month is currently over budget" : "Available after all recorded allocations")</small></article>
    </div>
</section>

<section class="fm-dashboard-section" aria-labelledby="journey-title">
    <div class="fm-dashboard-section-head"><div><p class="eyebrow">Money journey</p><h2 id="journey-title">How this month's money flows</h2></div><a asp-controller="MonthlyMoney" asp-action="EssentialBills" asp-route-year="@Model.Year" asp-route-month="@Model.Month">Manage monthly money</a></div>
    <div class="fm-money-journey" role="list">
        <div class="fm-journey-step" role="listitem"><i data-lucide="wallet-cards"></i><span>Income + carry forward</span><strong>@journey.EffectiveIncome.ToString("C", gb)</strong></div>
        <i class="fm-journey-arrow" data-lucide="arrow-right"></i>
        <div class="fm-journey-step" role="listitem"><i data-lucide="receipt"></i><span>Essential bills</span><strong>@((-journey.EssentialBills).ToString("C", gb))</strong></div>
        <i class="fm-journey-arrow" data-lucide="arrow-right"></i>
        <div class="fm-journey-step" role="listitem"><i data-lucide="shopping-basket"></i><span>Everyday spending</span><strong>@((-journey.EverydaySpending).ToString("C", gb))</strong></div>
        <i class="fm-journey-arrow" data-lucide="arrow-right"></i>
        <div class="fm-journey-step" role="listitem"><i data-lucide="circle-plus"></i><span>Extra expenses</span><strong>@((-journey.ExtraExpenses).ToString("C", gb))</strong></div>
        <i class="fm-journey-arrow" data-lucide="arrow-right"></i>
        <div class="fm-journey-step is-highlight" role="listitem"><i data-lucide="circle-dollar-sign"></i><span>Available before future allocations</span><strong>@journey.AvailableBeforeFutureAllocations.ToString("C", gb)</strong></div>
        <i class="fm-journey-arrow" data-lucide="arrow-right"></i>
        <div class="fm-journey-step" role="listitem"><i data-lucide="landmark"></i><span>Investments + reserve</span><strong>@((-(journey.Investments + journey.HouseholdReserveAllocations)).ToString("C", gb))</strong></div>
        <i class="fm-journey-arrow" data-lucide="arrow-right"></i>
        <div class="fm-journey-step @(journey.IsOverBudget ? "is-danger" : "is-positive")" role="listitem"><i data-lucide="flag"></i><span>Final remaining</span><strong>@journey.Remaining.ToString("C", gb)</strong></div>
    </div>
</section>

<section class="fm-dashboard-section" aria-labelledby="month-title">
    <div class="fm-dashboard-section-head"><div><p class="eyebrow">This month</p><h2 id="month-title">Spending and reserve summaries</h2></div></div>
    <div class="fm-summary-grid">
        @foreach (var summary in Model.Experience.MonthlySections)
        {
            <article class="fm-summary-card">
                <div class="fm-summary-icon"><i data-lucide="@summary.Icon"></i></div>
                <div><h3>@summary.Title</h3><strong>@summary.Amount.ToString("C", gb)</strong><p>@summary.ItemCount item@(summary.ItemCount == 1 ? "" : "s") · @summary.Description</p>
                    @if (summary.SecondaryAmount.HasValue) { <small>@summary.SecondaryLabel: @summary.SecondaryAmount.Value.ToString("C", gb)</small> }
                </div>
                @if (summary.Key == "reserve")
                {
                    <a asp-controller="SavingPots" asp-action="Index">View details <i data-lucide="arrow-right"></i></a>
                }
                else
                {
                    var workspaceAction = summary.Key switch
                    {
                        "bills" => "EssentialBills",
                        "everyday" => "EverydaySpending",
                        "extras" => "ExtraExpenses",
                        "investments" => "Investments",
                        _ => "EssentialBills"
                    };
                    <a asp-controller="MonthlyMoney" asp-action="@workspaceAction" asp-route-year="@Model.Year" asp-route-month="@Model.Month">View details <i data-lucide="arrow-right"></i></a>
                }
            </article>
        }
    </div>
    @if (largestExtra is not null)
    {
        <p class="fm-dashboard-context"><strong>Largest extra expense:</strong> @largestExtra.Name — @largestExtra.Amount.ToString("C", gb)</p>
    }
</section>

<section class="fm-dashboard-section" aria-labelledby="planning-title">
    <div class="fm-dashboard-section-head"><div><p class="eyebrow">Planning</p><h2 id="planning-title">Reserve health and 12-month outlook</h2></div></div>
    <div class="fm-planning-grid">
        <article class="fm-feature-card">
            <div class="fm-card-heading"><div><span>Household Reserve</span><h3>@Model.TotalGoalBalance.ToString("C", gb)</h3></div><i data-lucide="landmark"></i></div>
            <div class="fm-inline-metrics"><div><strong>@Model.Intelligence.ActivePotCount</strong><span>Active pots</span></div><div><strong>@Model.Intelligence.FundedThisMonth.ToString("C", gb)</strong><span>Funded this month</span></div><div><strong>@reserveUnallocated.ToString("C", gb)</strong><span>Unassigned</span></div></div>
            <a class="button" asp-controller="SavingPots" asp-action="Index">Open Household Reserve</a>
        </article>
        <article class="fm-feature-card">
            <div class="fm-card-heading"><div><span>12-month forecast</span><h3>@Model.ForecastSummary.ProjectedReserveBalance.ToString("C", gb)</h3><small>Based on @Model.ForecastSummary.ScenarioLabel</small></div><i data-lucide="chart-no-axes-combined"></i></div>
            <div class="fm-inline-metrics"><div><strong>@Model.ForecastSummary.ProjectedInterest.ToString("C", gb)</strong><span>Interest</span></div><div><strong class="@(Model.ForecastSummary.GoalsAtRisk > 0 ? "bad" : "good")">@Model.ForecastSummary.GoalsAtRisk</strong><span>Goals at risk</span></div><div><strong>@Model.ForecastSummary.GoalsExpectedToComplete</strong><span>Completing</span></div></div>
            <a class="button" asp-controller="Forecast" asp-action="Index" asp-route-months="12">View forecast</a>
        </article>
    </div>
</section>

<section class="fm-dashboard-section" aria-labelledby="attention-title">
    <div class="fm-dashboard-section-head"><div><p class="eyebrow">Attention and activity</p><h2 id="attention-title">What happens next</h2></div></div>
    <div class="fm-attention-grid">
        <article class="fm-list-card">
            <div class="fm-card-heading"><div><span>Upcoming actions</span><h3>@Model.Experience.UpcomingActions.Count item@(Model.Experience.UpcomingActions.Count == 1 ? "" : "s")</h3></div><i data-lucide="list-checks"></i></div>
            @if (Model.Experience.UpcomingActions.Count == 0) { <div class="fm-empty-state"><i data-lucide="circle-check-big"></i><strong>Nothing needs attention</strong><span>Your current reminders and targets are clear.</span></div> }
            else { <div class="fm-action-list">@foreach (var action in Model.Experience.UpcomingActions) { <a class="severity-@action.Severity" href="@action.Url"><span><strong>@action.Title</strong><small>@action.Detail</small></span><i data-lucide="chevron-right"></i></a> }</div> }
        </article>
        <article class="fm-list-card">
            <div class="fm-card-heading"><div><span>Recent activity</span><h3>Latest monthly entries</h3></div><i data-lucide="history"></i></div>
            @if (Model.Experience.RecentActivity.Count == 0) { <div class="fm-empty-state"><i data-lucide="inbox"></i><strong>No activity yet</strong><span>Add the first entry for @Model.MonthStart.ToString("MMMM").</span></div> }
            else { <div class="fm-activity-list">@foreach (var item in Model.Experience.RecentActivity) { <div><i data-lucide="@item.Icon"></i><span><strong>@item.Title</strong><small>@item.Detail · @item.OccurredAt.ToString("dd MMM")</small></span>@if (item.Amount.HasValue) { <b>@item.Amount.Value.ToString("C", gb)</b> }</div> }</div> }
        </article>
    </div>
</section>
