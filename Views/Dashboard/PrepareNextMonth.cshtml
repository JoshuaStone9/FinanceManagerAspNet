@model FinanceManagerAspNet.Models.PrepareNextMonthViewModel
@using System.Globalization
@{
    ViewData["Title"] = $"Prepare {Model.NextMonth:MMMM yyyy}";
    var gb = CultureInfo.GetCultureInfo("en-GB");
}

<section class="hero card fm-prepare-next-hero">
    <div>
        <p class="eyebrow">Prepare next month</p>
        <h1>Prepare @Model.NextMonth.ToString("MMMM yyyy")</h1>
        <p class="muted">Choose what to repeat from @Model.CurrentMonth.ToString("MMMM"). Recurring entries are selected automatically. One-off entries and extra expenses are optional.</p>
        <p class="muted">Existing entries are never replaced. For repeated names in a section, the most recent entry is offered. Money Pot selections record contributions and update pot balances.</p>
    </div>
    <a class="button" asp-action="Index" asp-route-year="@Model.Year" asp-route-month="@Model.Month">Back to @Model.CurrentMonth.ToString("MMMM")</a>
</section>

<form asp-action="ConfirmPrepareNextMonth" method="post" id="prepare-next-month">
    @Html.AntiForgeryToken()
    <input type="hidden" name="year" value="@Model.Year" />
    <input type="hidden" name="month" value="@Model.Month" />
    <section class="fm-prepare-next-summary" aria-live="polite" aria-atomic="true">
        <article class="fm-metric-card"><span>Selected entries</span><strong id="prepare-count">@Model.RecurringEntryCount</strong><small>Only selected entries will be added</small></article>
        <article class="fm-metric-card"><span>Selected income</span><strong id="prepare-income">@Model.IncomeTotal.ToString("C", gb)</strong><small>Income to record next month</small></article>
        <article class="fm-metric-card"><span>Selected spending &amp; allocations</span><strong id="prepare-allocations">@Model.AllocationTotal.ToString("C", gb)</strong><small>No balance or shortfall is carried forward</small></article>
    </section>
    <section class="card fm-prepare-next-card">
        @if (Model.EntryCount == 0)
        {
            <div class="fm-workspace-empty"><i data-lucide="calendar-check" aria-hidden="true"></i><strong>No entries to copy</strong><span>There are no eligible entries missing from next month.</span></div>
        }
        else
        {
            <div class="fm-prepare-next-head"><div><h2>Choose next month's entries</h2><p class="muted">Unchecking an entry skips it this time; its recurring setting stays unchanged. Amounts, account assignments, notes and the day of the month are retained where applicable.</p></div></div>
            <div class="fm-prepare-next-sections">
                @foreach (var preparationSection in Model.Sections)
                {
                    <fieldset class="fm-prepare-next-section">
                        <legend>@preparationSection.Title</legend>
                        @if (preparationSection.Items.Count == 0)
                        {
                            <p class="muted fm-prepare-empty">No missing entries to copy.</p>
                        }
                        else
                        {
                            <div class="fm-prepare-next-section-head">
                                <span>@preparationSection.Items.Count available</span>
                                <div class="fm-prepare-selection-actions">
                                    <button type="button" class="button" data-prepare-select="all">Select all</button>
                                    <button type="button" class="button" data-prepare-select="none">Clear</button>
                                </div>
                            </div>
                            <div class="fm-prepare-next-items">
                                @foreach (var item in preparationSection.Items)
                                {
                                    <label class="fm-prepare-next-item">
                                        <input type="checkbox" name="selectedEntries" value="@item.Key" checked="@item.IsRecurring" data-source="@item.Source" data-amount="@item.Amount.ToString(CultureInfo.InvariantCulture)" />
                                        <span class="fm-prepare-item-copy"><strong>@item.Name</strong><small>@(item.IsRecurring ? "Repeats monthly" : "One-off · optional") · @item.DateIn(Model.NextMonth).ToString("d MMM", gb)</small></span>
                                        <strong>@item.Amount.ToString("C", gb)</strong>
                                    </label>
                                }
                            </div>
                        }
                    </fieldset>
                }
            </div>
        }
        <div class="fm-prepare-next-actions">
            <div><strong>Ready to continue?</strong><span>Review your selections before recording next month's entries.</span></div>
            <button class="button primary" type="submit" id="prepare-submit" data-month="@Model.NextMonth.ToString("MMMM")">@(Model.RecurringEntryCount == 0 ? "Continue without adding entries" : $"Prepare {Model.NextMonth:MMMM}")</button>
        </div>
    </section>
</form>
@section Scripts {
    <script src="~/js/prepare-next-month.js" asp-append-version="true"></script>
}
