@model FinanceManagerAspNet.Models.FinancialTrendsViewModel
@using System.Globalization
@{
    ViewData["Title"] = "Financial Trends";
    var gb = CultureInfo.GetCultureInfo("en-GB");
    var activeMonths = Model.ActiveMonths;
    string Money(decimal value) => value.ToString("C", gb);
    string Height(decimal value, decimal maximum) => $"{Math.Clamp(Math.Abs(value) / maximum * 100m, 2m, 100m):0.##}%";
    string ChangeText(decimal? value) => value.HasValue ? $"{(value.Value >= 0 ? "+" : "-")}{Money(Math.Abs(value.Value))}" : "Not enough history";
}

<section class="fm-trends-page">
  <header class="fm-trends-hero">
    <div>
      <p class="eyebrow">Phase 10.12</p>
      <h1>Financial Trends</h1>
      <p>See how income, spending, future allocations and passive income are changing over time.</p>
    </div>
    <nav class="fm-range-switcher" aria-label="Trend range">
      @foreach (var range in new[] { 3, 6, 12 })
      {
        <a class="@(Model.RangeMonths == range ? "active" : "")" asp-action="Index" asp-route-range="@range">@range months</a>
      }
    </nav>
  </header>

  @if (Model.HiddenEmptyMonthCount > 0 && activeMonths.Count > 0)
  {
    <aside class="fm-trend-context-note">
      <i data-lucide="filter"></i>
      <span>Showing @activeMonths.Count recorded month@(activeMonths.Count == 1 ? "" : "s") within the selected @Model.RangeMonths-month period. @Model.HiddenEmptyMonthCount empty month@(Model.HiddenEmptyMonthCount == 1 ? " was" : "s were") hidden.</span>
    </aside>
  }

  <section class="fm-trend-summary-grid" aria-label="Trend summary">
    <article class="fm-stat-card">
      <span>Average monthly surplus <abbr title="Average remaining money across months that contain recorded income.">?</abbr></span>
      <strong class="@(Model.AverageMonthlySurplus < 0 ? "negative" : "positive")">@Money(Model.AverageMonthlySurplus)</strong>
      <small>Across @Model.IncomeMonths.Count month@(Model.IncomeMonths.Count == 1 ? "" : "s") with recorded income</small>
    </article>
    <article class="fm-stat-card">
      <span>Passive income <abbr title="Interest, dividends, rental income and other income generated by assets.">?</abbr></span>
      <strong>@Money(Model.TotalPassiveIncome)</strong>
      <small>@Model.PassiveIncomeShare.ToString("0.0")% of recorded income</small>
      @if (Model.LatestPassiveIncomeChange.HasValue)
      {
        <em class="fm-change-badge @(Model.LatestPassiveIncomeChange.Value < 0 ? "down" : "up")">@ChangeText(Model.LatestPassiveIncomeChange) vs previous active month</em>
      }
    </article>
    <article class="fm-stat-card">
      <span>Total core spending <abbr title="Essential bills, everyday spending and extra expenses.">?</abbr></span>
      <strong>@Money(Model.TotalSpending)</strong>
      <small>Across recorded months</small>
      @if (Model.LatestSpendingChange.HasValue)
      {
        <em class="fm-change-badge @(Model.LatestSpendingChange.Value > 0 ? "down" : "up")">@ChangeText(Model.LatestSpendingChange) vs previous active month</em>
      }
    </article>
    <article class="fm-stat-card">
      <span>Best monthly result <abbr title="The recorded month with the highest remaining amount after spending and future allocations.">?</abbr></span>
      <strong>@Money(Model.BestMonthlySurplus)</strong>
      <small>@(Model.BestMonth?.FullLabel ?? "No recorded months")</small>
      @if (Model.LatestSurplusChange.HasValue)
      {
        <em class="fm-change-badge @(Model.LatestSurplusChange.Value < 0 ? "down" : "up")">Latest month @ChangeText(Model.LatestSurplusChange)</em>
      }
    </article>
  </section>

  @if (activeMonths.Count == 0)
  {
    <section class="fm-empty-trends">
      <i data-lucide="chart-no-axes-combined"></i>
      <h2>No trend data yet</h2>
      <p>Record income and monthly spending to begin building your financial history.</p>
      <a class="fm-button-primary" asp-controller="MonthlyMoney" asp-action="Income">Record income</a>
    </section>
  }
  else
  {
    <section class="fm-trend-panel">
      <div class="fm-trend-panel-heading">
        <div><p class="eyebrow">Cash flow</p><h2>Monthly money movement</h2><p>Income compared with core spending, future allocations and the amount left over. Select a month to open its dashboard.</p></div>
        <div class="fm-chart-legend"><span title="Operating and passive income recorded in the month"><i class="income"></i>Income</span><span title="Bills, everyday spending and extra expenses"><i class="spending"></i>Core spending</span><span title="Investments and Money Pot contributions"><i class="future"></i>Future allocations</span></div>
      </div>
      <div class="fm-cashflow-chart" role="img" aria-label="Cash-flow chart for recorded months in the selected period">
        @foreach (var month in activeMonths)
        {
          <a class="fm-chart-month" asp-controller="Dashboard" asp-action="Index" asp-route-year="@month.Year" asp-route-month="@month.Month" aria-label="Open @month.FullLabel dashboard">
            <div class="fm-chart-bars">
              <div class="fm-chart-bar income" style="height:@Height(month.TotalIncome, Model.CashFlowChartMaximum)" title="Income @Money(month.TotalIncome)"></div>
              <div class="fm-chart-bar spending" style="height:@Height(month.CoreSpending, Model.CashFlowChartMaximum)" title="Core spending @Money(month.CoreSpending)"></div>
              <div class="fm-chart-bar future" style="height:@Height(month.FutureAllocations, Model.CashFlowChartMaximum)" title="Future allocations @Money(month.FutureAllocations)"></div>
            </div>
            <strong class="@(month.Remaining < 0 ? "negative" : "positive")">@Money(month.Remaining)</strong>
            <span>@month.Label</span>
          </a>
        }
      </div>
      <div class="fm-trend-table-wrap">
        <table class="fm-trend-table">
          <thead><tr><th>Month</th><th>Operating income</th><th>Passive income</th><th>Core spending</th><th>Future allocations</th><th>Remaining</th><th></th></tr></thead>
          <tbody>
          @foreach (var month in activeMonths.OrderByDescending(x => x.MonthStart))
          {
            <tr><th>@month.FullLabel</th><td>@Money(month.OperatingIncome)</td><td>@Money(month.PassiveIncome)</td><td>@Money(month.CoreSpending)</td><td>@Money(month.FutureAllocations)</td><td class="@(month.Remaining < 0 ? "negative" : "positive")">@Money(month.Remaining)</td><td><a class="fm-table-link" asp-controller="Dashboard" asp-action="Index" asp-route-year="@month.Year" asp-route-month="@month.Month">View month</a></td></tr>
          }
          </tbody>
        </table>
      </div>
    </section>

    <section class="fm-trend-panel">
      <div class="fm-trend-panel-heading">
        <div><p class="eyebrow">Passive income</p><h2>Income earned by your money</h2><p>Interest, dividends, rental income and other passive sources recorded in Income.</p></div>
        <strong class="fm-panel-total">@Money(Model.TotalPassiveIncome)</strong>
      </div>
      <div class="fm-passive-chart">
        @foreach (var month in activeMonths)
        {
          <a class="fm-passive-month" asp-controller="Dashboard" asp-action="Index" asp-route-year="@month.Year" asp-route-month="@month.Month" aria-label="Open @month.FullLabel dashboard">
            <div class="fm-passive-bar-track"><div class="fm-passive-bar" style="height:@Height(month.PassiveIncome, Model.PassiveChartMaximum)" title="Passive income @Money(month.PassiveIncome)"></div></div>
            <strong>@Money(month.PassiveIncome)</strong><span>@month.Label</span>
          </a>
        }
      </div>
      <div class="fm-passive-breakdown-grid">
        <article><span>Interest</span><strong>@Money(activeMonths.Sum(x => x.InterestIncome))</strong></article>
        <article><span>Dividends</span><strong>@Money(activeMonths.Sum(x => x.DividendIncome))</strong></article>
        <article><span>Rental income</span><strong>@Money(activeMonths.Sum(x => x.RentalIncome))</strong></article>
        <article><span>Other passive income</span><strong>@Money(activeMonths.Sum(x => x.OtherPassiveIncome))</strong></article>
      </div>
    </section>

    @if (Model.Insights.Count > 0)
    {
      <section class="fm-trend-panel fm-trend-insights">
        <div class="fm-trend-panel-heading"><div><p class="eyebrow">Insights</p><h2>What changed</h2><p>A short reading of the recorded months in this range.</p></div></div>
        <div class="fm-insight-grid">
          @foreach (var insight in Model.Insights)
          {
            <article><i data-lucide="sparkles"></i><p>@insight</p></article>
          }
        </div>
      </section>
    }
  }
</section>
