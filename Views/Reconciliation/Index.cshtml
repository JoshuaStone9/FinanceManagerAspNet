@model FinanceManagerAspNet.Models.AccountReconciliationViewModel
@using System.Globalization
@{ ViewData["Title"] = "Balance Reconciliation"; var gb = CultureInfo.GetCultureInfo("en-GB"); var canEdit = User.Identity?.IsAuthenticated == true; }

<header class="fm-dashboard-hero">
    <div>
        <p class="eyebrow">Phase 10.10</p>
        <h1>Balance Reconciliation</h1>
        <p>Optionally compare Finance Manager with your real accounts and update a recorded balance whenever you choose.</p>
    </div>
</header>

@if (TempData["Success"] is string success) { <div class="fm-dashboard-notice">@success</div> }
@if (TempData["Error"] is string error) { <div class="alert error">@error</div> }

<section class="card">
    <p class="eyebrow">Optional balance check</p>
    <h2>Recorded account balances</h2>
    <p class="muted">Interest recorded from the Income workspace already counts towards that month's available income. Updating a balance here is a separate manual check and does not create another income entry.</p>

    <div class="fm-reconciliation-grid">
        @foreach (var account in Model.Accounts)
        {
            <article class="fm-reconciliation-card">
                <div>
                    <h3>@account.AccountName</h3>
                    <p class="muted">Recorded balance</p>
                    <strong class="fm-reconciliation-balance">@account.RecordedBalance.ToString("C", gb)</strong>
                    <small>Balance updated @account.BalanceUpdatedAt.ToString("dd MMM yyyy")</small>
                    <small>Last reconciled: @(account.LastReconciledAt?.ToString("dd MMM yyyy") ?? "Never")</small>
                </div>
                @if (canEdit)
                {
                    <form asp-action="UpdateBalance" method="post" class="account-form">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="sourceKey" value="@account.SourceKey" />
                        <label>Actual balance today
                            <input name="actualBalance" type="number" min="0" step="0.01" value="@account.RecordedBalance.ToString("0.00", CultureInfo.InvariantCulture)" required />
                        </label>
                        <button class="primary" type="submit">Update recorded balance</button>
                    </form>
                }
            </article>
        }
    </div>
</section>
