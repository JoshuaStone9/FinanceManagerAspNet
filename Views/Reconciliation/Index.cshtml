@model FinanceManagerAspNet.Models.AccountReconciliationViewModel
@using System.Globalization
@{
    ViewData["Title"] = "Account Management";
    var gb = CultureInfo.GetCultureInfo("en-GB");
    var canEdit = User.Identity?.IsAuthenticated == true;
    var firstPendingAccount = Model.FirstAccountNeedingReconciliation;
    var oldestPendingDate = Model.OldestPendingInterestDate;
    var pendingAgeDays = oldestPendingDate.HasValue
        ? Math.Max(0, (DateTime.Today - oldestPendingDate.Value.Date).Days)
        : 0;
}

<header class="fm-dashboard-hero fm-account-hero">
    <div>
        <p class="eyebrow">Phase 11.6</p>
        <h1>Account Management</h1>
        <p>Manage account settings and keep recorded balances aligned with interest already added to monthly income.</p>
    </div>
    <div class="fm-account-hero-actions">
        @if (canEdit)
        {
            <button class="primary" type="button" data-toggle-new-account>Add account</button>
        }
        <a class="button" asp-controller="Statistics" asp-action="Index">View Statistics</a>
    </div>
</header>

@if (TempData["Success"] is string success) { <div class="fm-dashboard-notice">@success</div> }
@if (TempData["Error"] is string error) { <div class="alert error">@error</div> }
@if (TempData["Warning"] is string warning) { <div class="alert warning">@warning</div> }

<section class="card fm-interest-reconciliation-summary" aria-labelledby="reserve-reconciliation-title">
    <div class="fm-interest-reconciliation-copy">
        <p class="eyebrow">Household Reserve reconciliation</p>
        <h2 id="reserve-reconciliation-title">@Model.ReserveReconciliationStatus</h2>
        <p class="muted">
            This compares the combined balance of the accounts selected for the Household Reserve
            with the base reserve amount in Settings plus the current value of all active virtual pots.
        </p>
        @if (Model.HasReserveConcern)
        {
            <p class="muted">
                The selected accounts contain <strong>@Math.Abs(Model.ReserveDifference).ToString("C", gb)</strong>
                @(Model.ReserveDifference > 0 ? "more" : "less") than is currently explained by the base reserve and logged pots.
            </p>
        }
        else if (Model.ReserveReconciliationStatus == "Within expected interest variance")
        {
            <p class="muted">The difference is within the configured @Model.BalanceTolerance.ToString("C", gb) tolerance for interest and rounding.</p>
        }
    </div>
    <div class="fm-interest-reconciliation-stats">
        <div>
            <span>Selected accounts</span>
            <strong>@Model.SelectedAccountsTotal.ToString("C", gb)</strong>
        </div>
        <div>
            <span>Base reserve</span>
            <strong>@Model.BaseReserveAmount.ToString("C", gb)</strong>
        </div>
        <div>
            <span>Virtual pots</span>
            <strong>@Model.LoggedVirtualPotsTotal.ToString("C", gb)</strong>
        </div>
        <div>
            <span>Expected total</span>
            <strong>@Model.ExpectedReserveTotal.ToString("C", gb)</strong>
        </div>
        <div>
            <span>Difference</span>
            <strong>@Model.ReserveDifference.ToString("C", gb)</strong>
        </div>
    </div>
</section>

@if (Model.AccountsNeedingInterestReconciliation > 0)
{
    <section class="card fm-interest-reconciliation-summary" aria-labelledby="interest-reconciliation-title">
        <div class="fm-interest-reconciliation-copy">
            <p class="eyebrow">Interest reconciliation</p>
            <h2 id="interest-reconciliation-title">@Model.AccountsNeedingInterestReconciliation account@(Model.AccountsNeedingInterestReconciliation == 1 ? string.Empty : "s") require reconciliation</h2>
            <p class="muted">Confirmed interest is waiting to be reflected in the relevant recorded balances. It remains carried forward until you complete a balance check.</p>
        </div>
        <div class="fm-interest-reconciliation-stats">
            <div>
                <span>Accounts</span>
                <strong>@Model.AccountsNeedingInterestReconciliation</strong>
            </div>
            <div>
                <span>Pending</span>
                <strong>@Model.TotalPendingInterest.ToString("C", gb)</strong>
            </div>
            <div>
                <span>Oldest</span>
                <strong>@(pendingAgeDays == 0 ? "Today" : pendingAgeDays == 1 ? "1 day" : $"{pendingAgeDays} days")</strong>
                @if (oldestPendingDate.HasValue)
                {
                    <small>@oldestPendingDate.Value.ToString("dd MMM yyyy")</small>
                }
            </div>
            @if (canEdit && firstPendingAccount is not null)
            {
                var firstPendingPanelId = $"account-panel-{firstPendingAccount.SourceKey.Replace(':', '-').Replace(' ', '-')}-balance";
                <button class="primary" type="button" data-review-pending-accounts aria-controls="@firstPendingPanelId">Review accounts</button>
            }
        </div>
    </section>
}

@if (canEdit)
{
    <section class="card fm-add-account-panel" data-new-account-panel hidden>
        <div class="fm-section-heading">
            <div>
                <p class="eyebrow">New account</p>
                <h2>Add an account</h2>
                <p class="muted">Add an existing or new account, including its provider, wrapper, holding type and opening balance.</p>
            </div>
            <button class="button fm-icon-button" type="button" data-close-new-account aria-label="Close add account form">Close</button>
        </div>

        <form asp-action="AddAccount" method="post" class="fm-add-account-form fm-account-editor-grid">
            @Html.AntiForgeryToken()
            <label class="fm-field-span-2">
                <span>Account name</span>
                <input name="name" placeholder="e.g. Cash ISA" required />
            </label>
            <label>
                <span>Provider</span>
                <input name="provider" placeholder="e.g. Trading 212" value="Other" required />
            </label>
            <label>
                <span>Account wrapper</span>
                <select name="accountType">
                    <option>Savings</option>
                    <option>Cash ISA</option>
                    <option>Stocks &amp; Shares ISA</option>
                    <option>General Investment Account</option>
                </select>
            </label>
            <label>
                <span>Holding type</span>
                <select name="holdingType">
                    <option>Cash</option>
                    <option>Money Market Fund</option>
                    <option>Stocks &amp; Shares</option>
                    <option>Mixed</option>
                </select>
            </label>
            <label>
                <span>Starting balance</span>
                <input name="openingBalance" type="number" min="0" step="0.01" value="0.00" required />
                <small>Use the amount already held when bringing an existing account into Finance Manager.</small>
            </label>
            <label>
                <span>Interest rate (AER)</span>
                <input name="interestRate" type="number" min="0" step="0.01" value="0.00" required />
            </label>
            <label>
                <span>Monthly contribution</span>
                <input name="monthlyContribution" type="number" min="0" step="0.01" value="0.00" required />
            </label>
            <label>
                <span>Default interest handling</span>
                <select name="interestHandling">
                    <option value="Keep invested" selected>Keep invested</option>
                    <option value="Add to Monthly Income">Add to Monthly Income</option>
                </select>
                <small>You can override this choice for an individual payment each month.</small>
            </label>
            <label class="fm-account-toggle">
                <input name="includeInGlobalGoal" type="checkbox" value="true" checked />
                <span>Include in Statistics forecast</span>
            </label>
            <div class="fm-account-editor-actions fm-field-span-all">
                <button class="primary" type="submit">Add account</button>
                <button class="button" type="button" data-close-new-account>Cancel</button>
            </div>
        </form>
    </section>
}

<section class="card fm-account-management-panel">
    <div class="fm-section-heading">
        <div>
            <p class="eyebrow">Forecast accounts</p>
            <h2>@Model.Accounts.Count recorded account@(Model.Accounts.Count == 1 ? string.Empty : "s")</h2>
            <p class="muted">Expand an account only when you need to change its settings or check its current balance.</p>
        </div>
    </div>

    <div class="fm-account-card-grid">
        @foreach (var account in Model.Accounts)
        {
            var panelId = $"account-panel-{account.SourceKey.Replace(':', '-').Replace(' ', '-')}";
            <article class="fm-account-summary-card" data-account-card data-needs-reconciliation="@account.NeedsInterestReconciliation.ToString().ToLowerInvariant()">
                <div class="fm-account-summary-topline">
                    <div>
                        <h3>@account.AccountName</h3>
                        <p class="fm-account-primary-balance">@account.RecordedBalance.ToString("C", gb)</p>
                    </div>
                    <span class="fm-account-forecast-state @(account.IncludeInForecast ? "is-included" : "")">
                        @(account.IncludeInForecast ? "Included in forecast" : "Excluded")
                    </span>
                </div>

                <div class="fm-account-summary-meta">
                    <span>@account.Provider</span>
                    <span>@account.AccountType</span>
                    <span>@account.HoldingType</span><span>@(account.TaxTreatment == "Taxable" ? $"Taxable at {account.TaxRate:0.##}%" : "Tax free")</span>
                    <span>@account.InterestRate.ToString("0.##")% AER</span>
                    <span>@account.MonthlyContribution.ToString("C", gb) monthly</span>
                    <span>Interest: @account.InterestHandling</span>
                </div>

                <div class="fm-account-summary-dates">
                    <span>Updated @account.BalanceUpdatedAt.ToString("dd MMM yyyy")</span>
                    <span>Last balance check: @(account.LastReconciledAt?.ToString("dd MMM yyyy") ?? "Never")</span>
                </div>

                <div class="fm-balance-reconciliation-state is-ok">
                    <strong>@account.ReconciliationStatus</strong>
                    <span>This account contributes @account.RecordedBalance.ToString("C", gb) to the combined Household Reserve check when selected.</span>
                </div>

                @if (canEdit)
                {
                    <div class="fm-account-card-actions">
                        <button class="button" type="button" data-account-panel-trigger="settings" aria-controls="@panelId-settings" aria-expanded="false">Edit account</button>
                        <button class="primary" type="button" data-account-panel-trigger="balance" aria-controls="@panelId-balance" aria-expanded="false">Update balance</button>
                    </div>

                    <div class="fm-account-expand-panel" id="@panelId-settings" data-account-panel="settings" hidden>
                        <div class="fm-account-panel-heading">
                            <div>
                                <p class="eyebrow">Account settings</p>
                                <h4>Edit @account.AccountName</h4>
                            </div>
                            <button class="button fm-panel-close" type="button" data-account-panel-close>Close</button>
                        </div>

                        <form asp-action="SaveAccount" method="post" class="fm-account-editor-grid">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="id" value="@account.AccountId" />
                            <label class="fm-field-span-2">
                                <span>Account name</span>
                                <input name="name" value="@account.AccountName" @(account.AccountId == 0 ? "readonly" : "") required />
                            </label>
                            <label>
                                <span>Provider</span>
                                <input name="provider" value="@account.Provider" required />
                            </label>
                            <label>
                                <span>Account wrapper</span>
                                <select name="accountType">
                                    @foreach (var option in new[] { "Savings", "Cash ISA", "Stocks & Shares ISA", "General Investment Account" })
                                    {
                                        <option value="@option" selected="@(account.AccountType == option)">@option</option>
                                    }
                                </select>
                            </label>
                            <label>
                                <span>Holding type</span>
                                <select name="holdingType">
                                    @foreach (var option in new[] { "Cash", "Money Market Fund", "Stocks & Shares", "Mixed" })
                                    {
                                        <option value="@option" selected="@(account.HoldingType == option)">@option</option>
                                    }
                                </select>
                            </label>
                            <label>
                                <span>Starting balance</span>
                                <input name="startingBalance" type="number" min="0" step="0.01" value="@account.StartingBalance.ToString("0.00", CultureInfo.InvariantCulture)" required />
                                <small>Changing this adjusts the recorded balance by the same difference, preserving later activity.</small>
                            </label>
                            <label>
                                <span>Interest rate (AER)</span>
                                <input name="interestRate" type="number" min="0" step="0.01" value="@account.InterestRate.ToString("0.####", CultureInfo.InvariantCulture)" required />
                            </label>
                            <label>
                                <span>Monthly contribution</span>
                                <input name="monthlyContribution" type="number" min="0" step="0.01" value="@account.MonthlyContribution.ToString("0.00", CultureInfo.InvariantCulture)" required />
                            </label>
                            <label><span>Tax treatment</span><select name="taxTreatment">@foreach (var option in new[] { "Tax Free", "Taxable" }) { <option value="@option" selected="@(account.TaxTreatment == option)">@option</option> }</select></label>
                            <label><span>Tax rate</span><input name="taxRate" type="number" min="0" max="100" step="0.01" value="@account.TaxRate.ToString("0.##", CultureInfo.InvariantCulture)"/><small>For example, 22 for a 22% deduction.</small></label>
                            <label><span>Tax starts</span><input name="taxEffectiveFrom" type="date" value="@account.TaxEffectiveFrom?.ToString("yyyy-MM-dd")"/><small>Useful for a future rule change such as April 2027.</small></label>
                            <label>
                                <span>Default interest handling</span>
                                <select name="interestHandling">
                                    @foreach (var option in new[] { "Keep invested", "Add to Monthly Income" })
                                    {
                                        <option value="@option" selected="@(account.InterestHandling == option)">@option</option>
                                    }
                                </select>
                                <small>Used as the pre-selected choice when monthly interest is confirmed.</small>
                            </label>
                            <label class="fm-account-toggle fm-field-span-2">
                                <input name="includeInGlobalGoal" type="checkbox" value="true" checked="@account.IncludeInForecast" />
                                <span>Include in Statistics forecast</span>
                            </label>
                            <div class="fm-account-editor-actions fm-field-span-all">
                                <button class="primary" type="submit">Save changes</button>
                                <button class="button" type="button" data-account-panel-close>Cancel</button>
                                @if (account.AccountId > 0)
                                {
                                    <button class="danger-inline fm-delete-account-trigger" type="submit" form="delete-account-@account.AccountId">Delete account</button>
                                }
                            </div>
                        </form>

                        @if (account.AccountId > 0)
                        {
                            <form id="delete-account-@account.AccountId" asp-action="DeleteAccount" method="post" data-confirm="Delete @account.AccountName? This cannot be undone.">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="id" value="@account.AccountId" />
                            </form>
                        }
                    </div>

                    <div class="fm-account-expand-panel" id="@panelId-balance" data-account-panel="balance" hidden>
                        <div class="fm-account-panel-heading">
                            <div>
                                <p class="eyebrow">Balance check</p>
                                <h4>Update @account.AccountName</h4>
                            </div>
                            <button class="button fm-panel-close" type="button" data-account-panel-close>Close</button>
                        </div>

                        <div class="fm-balance-context">
                            <span>Recorded balance</span>
                            <strong>@account.RecordedBalance.ToString("C", gb)</strong>
                            @if (account.PendingInterestCount > 0)
                            {
                                <span>Confirmed interest not yet reflected</span>
                                <strong>+@account.PendingInterest.ToString("C", gb)</strong>
                                <span>Suggested current balance</span>
                                <strong>@account.SuggestedBalance.ToString("C", gb)</strong>
                            }
                            <small>Saving here only updates the recorded account value. It never creates another income entry or changes your monthly budget.</small>
                        </div>

                        @if (account.RecentActivities.Count > 0)
                        {
                            <div class="fm-recent-account-activity">
                                <h5>Recent activity that may explain a difference</h5>
                                <ul>
                                    @foreach (var activity in account.RecentActivities)
                                    {
                                        <li><span>@activity.OccurredAt.ToLocalTime().ToString("dd MMM HH:mm")</span><strong>@activity.Title</strong><small>@(activity.Amount?.ToString("C", gb) ?? activity.EventType)</small></li>
                                    }
                                </ul>
                            </div>
                        }

                        <form asp-action="UpdateBalance" method="post" class="fm-balance-check-form" data-balance-confirm data-recorded-balance="@account.RecordedBalance.ToString("0.00", CultureInfo.InvariantCulture)" data-pending-interest="@account.PendingInterest.ToString("0.00", CultureInfo.InvariantCulture)" data-account-name="@account.AccountName">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="sourceKey" value="@account.SourceKey" />
                            <label>
                                <span>Current account balance</span>
                                <input name="actualBalance" type="number" min="0" step="0.01" value="@(account.PendingInterestCount > 0 ? account.SuggestedBalance : account.RecordedBalance).ToString("0.00", CultureInfo.InvariantCulture)" required />
                            </label>
                            @if (account.PendingInterestCount > 0)
                            {
                                <label class="fm-account-toggle">
                                    <input name="reconcilePendingInterest" type="checkbox" value="true" checked />
                                    <span>Mark the @account.PendingInterestCount pending interest payment@(account.PendingInterestCount == 1 ? string.Empty : "s") as reflected in this balance</span>
                                </label>
                            }
                            <button class="primary" type="submit">Save current balance</button>
                        </form>
                    </div>
                }
            </article>
        }
    </div>
</section>

<script>
(() => {
    const newAccountPanel = document.querySelector('[data-new-account-panel]');
    const newAccountTriggers = document.querySelectorAll('[data-toggle-new-account]');
    const newAccountClosers = document.querySelectorAll('[data-close-new-account]');

    const setNewAccountVisibility = visible => {
        if (!newAccountPanel) return;
        newAccountPanel.hidden = !visible;
        if (visible) {
            newAccountPanel.scrollIntoView({ behavior: 'smooth', block: 'start' });
            newAccountPanel.querySelector('input[name="name"]')?.focus();
        }
    };

    newAccountTriggers.forEach(button => button.addEventListener('click', () => setNewAccountVisibility(true)));
    newAccountClosers.forEach(button => button.addEventListener('click', () => setNewAccountVisibility(false)));

    const closeAllPanels = exceptPanel => {
        document.querySelectorAll('[data-account-panel]').forEach(panel => {
            if (panel !== exceptPanel) panel.hidden = true;
        });
        document.querySelectorAll('[data-account-panel-trigger]').forEach(trigger => {
            const target = document.getElementById(trigger.getAttribute('aria-controls'));
            trigger.setAttribute('aria-expanded', target && !target.hidden ? 'true' : 'false');
        });
    };

    document.querySelector('[data-review-pending-accounts]')?.addEventListener('click', event => {
        const targetId = event.currentTarget.getAttribute('aria-controls');
        const target = targetId ? document.getElementById(targetId) : null;
        if (!target) return;

        closeAllPanels(target);
        target.hidden = false;
        const trigger = document.querySelector(`[aria-controls="${target.id}"]`);
        trigger?.setAttribute('aria-expanded', 'true');
        target.closest('[data-account-card]')?.scrollIntoView({ behavior: 'smooth', block: 'center' });
        window.setTimeout(() => target.querySelector('input[name="actualBalance"]')?.focus(), 350);
    });

    document.querySelectorAll('[data-account-panel-trigger]').forEach(trigger => {
        trigger.addEventListener('click', () => {
            const target = document.getElementById(trigger.getAttribute('aria-controls'));
            if (!target) return;
            const shouldOpen = target.hidden;
            closeAllPanels(shouldOpen ? target : null);
            target.hidden = !shouldOpen;
            trigger.setAttribute('aria-expanded', shouldOpen ? 'true' : 'false');
            if (shouldOpen) target.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
        });
    });

    document.querySelectorAll('[data-account-panel-close]').forEach(button => {
        button.addEventListener('click', () => {
            const panel = button.closest('[data-account-panel]');
            if (!panel) return;
            panel.hidden = true;
            const trigger = document.querySelector(`[aria-controls="${panel.id}"]`);
            trigger?.setAttribute('aria-expanded', 'false');
        });
    });

    document.querySelectorAll('[data-balance-confirm]').forEach(form => {
        form.addEventListener('submit', event => {
            const input = form.querySelector('input[name="actualBalance"]');
            const next = Number.parseFloat(input?.value ?? '0');
            const current = Number.parseFloat(form.dataset.recordedBalance ?? '0');
            if (!Number.isFinite(next) || !Number.isFinite(current)) return;

            const difference = next - current;
            const formatter = new Intl.NumberFormat('en-GB', { style: 'currency', currency: 'GBP' });
            const direction = difference > 0 ? 'increase' : difference < 0 ? 'decrease' : 'leave';
            const reconcile = form.querySelector('input[name="reconcilePendingInterest"]')?.checked === true;
            const pending = Number.parseFloat(form.dataset.pendingInterest ?? '0');
            const reconciliationText = reconcile && pending > 0
                ? ` The existing ${formatter.format(pending)} interest income will be marked as reconciled; no second income entry will be created.`
                : ' No income entry will be created.';
            const message = difference === 0
                ? `This will confirm that ${form.dataset.accountName} remains at ${formatter.format(next)}.${reconciliationText}`
                : `This will ${direction} the recorded balance for ${form.dataset.accountName} by ${formatter.format(Math.abs(difference))}, from ${formatter.format(current)} to ${formatter.format(next)}.${reconciliationText}`;

            if (!window.confirm(message)) event.preventDefault();
        });
    });
})();
</script>
