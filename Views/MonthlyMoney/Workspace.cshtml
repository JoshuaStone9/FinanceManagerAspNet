@model FinanceManagerAspNet.Models.MonthlyMoneyWorkspaceViewModel
@using System.Globalization
@using System.Text.Json

@{
    ViewData["Title"] = $"{Model.Title} - {Model.MonthStart:MMMM yyyy}";
    var gb = CultureInfo.GetCultureInfo("en-GB");
    var canEdit = User.Identity?.IsAuthenticated == true;
    var defaultEntryDate = new DateTime(
        Model.Year,
        Model.Month,
        Math.Min(DateTime.Today.Day, DateTime.DaysInMonth(Model.Year, Model.Month)));
    var optionsJson = JsonSerializer.Serialize(Model.ExistingOptions);
    var workspaceError = TempData["WorkspaceError"] as string;
    var draftName = TempData["WorkspaceDraftName"] as string ?? string.Empty;
    var draftAmount = TempData["WorkspaceDraftAmount"] as string ?? string.Empty;
    var draftDate = TempData["WorkspaceDraftDate"] as string;
    var draftCategory = TempData["WorkspaceDraftCategory"] as string ?? string.Empty;
    var draftType = TempData["WorkspaceDraftType"] as string ?? string.Empty;
    var draftLength = TempData["WorkspaceDraftLength"] as string ?? string.Empty;
    var draftNotes = TempData["WorkspaceDraftNotes"] as string ?? string.Empty;
    var entryDateValue = string.IsNullOrWhiteSpace(draftDate)
        ? defaultEntryDate.ToString("yyyy-MM-dd")
        : draftDate;
}

<header class="fm-workspace-hero">
    <div class="fm-workspace-heading">
        <div class="fm-workspace-icon"><i data-lucide="@Model.Icon"></i></div>
        <div>
            <p class="eyebrow">@Model.Eyebrow</p>
            <h1>@Model.Title</h1>
            <p>@Model.Description</p>
        </div>
    </div>

    <nav class="fm-dashboard-month" aria-label="Change @Model.Title month">
        <a class="fm-month-button"
           asp-action="@Model.ActionName"
           asp-route-year="@Model.PreviousMonth.Year"
           asp-route-month="@Model.PreviousMonth.Month"
           aria-label="Previous month">
            <i data-lucide="chevron-left"></i>
        </a>
        <span class="fm-month-label" aria-live="polite">@Model.MonthStart.ToString("MMMM yyyy")</span>
        <a class="fm-month-button"
           asp-action="@Model.ActionName"
           asp-route-year="@Model.NextMonth.Year"
           asp-route-month="@Model.NextMonth.Month"
           aria-label="Next month">
            <i data-lucide="chevron-right"></i>
        </a>
    </nav>
</header>

<nav class="fm-workspace-tabs" aria-label="Monthly money workspaces">
    <a class="@(Model.ActionName == "EssentialBills" ? "active" : "")" asp-action="EssentialBills" asp-route-year="@Model.Year" asp-route-month="@Model.Month">Essential bills</a>
    <a class="@(Model.ActionName == "EverydaySpending" ? "active" : "")" asp-action="EverydaySpending" asp-route-year="@Model.Year" asp-route-month="@Model.Month">Everyday spending</a>
    <a class="@(Model.ActionName == "ExtraExpenses" ? "active" : "")" asp-action="ExtraExpenses" asp-route-year="@Model.Year" asp-route-month="@Model.Month">Extra expenses</a>
    <a class="@(Model.ActionName == "Investments" ? "active" : "")" asp-action="Investments" asp-route-year="@Model.Year" asp-route-month="@Model.Month">Investments</a>
    <a class="@(Model.ActionName == "MoneyPots" ? "active" : "")" asp-action="MoneyPots" asp-route-year="@Model.Year" asp-route-month="@Model.Month">Money pots</a>
</nav>

<section class="fm-workspace-metrics" aria-label="@Model.Title summary">
    <article class="fm-metric-card">
        <span>Total this month</span>
        <strong>@Model.Total.ToString("C", gb)</strong>
        <small>@Model.MonthStart.ToString("MMMM yyyy")</small>
    </article>
    <article class="fm-metric-card">
        <span>@(Model.IsMoneyPots ? "Contributions" : "Recorded entries")</span>
        <strong>@Model.Rows.Count</strong>
        <small>@(Model.IsMoneyPots ? "Contribution records this month" : $"Item{(Model.Rows.Count == 1 ? "" : "s")} in this workspace")</small>
    </article>
    <article class="fm-metric-card">
        <span>@(Model.IsMoneyPots ? "Average contribution" : "Average entry")</span>
        <strong>@Model.Average.ToString("C", gb)</strong>
        <small>Across recorded entries</small>
    </article>
    <article class="fm-metric-card">
        <span>Monthly behaviour</span>
        <strong>@(Model.SupportsPermanentEntries ? "Recurring supported" : "One-off only")</strong>
        <small>@(Model.SupportsPermanentEntries ? "Choose which entries should repeat next month" : "These costs stay in the selected month")</small>
    </article>
</section>

@if (canEdit && Model.HasMonthSetupItems)
{
    <section class="fm-month-setup-card" id="month-setup">
        <div class="fm-month-setup-head">
            <div>
                <p class="eyebrow">Month setup</p>
                <h2>Prepare @Model.MonthStart.ToString("MMMM yyyy")</h2>
                <p class="muted">Select the recurring entries you want this month. Each amount starts from the latest recorded month and can still be adjusted.</p>
            </div>
            <span class="fm-status-pill">@Model.MissingPermanentTemplates.Count ready</span>
        </div>

        <form asp-controller="MonthlyMoney" asp-action="SetupMonth" method="post" class="fm-month-setup-form">
            @Html.AntiForgeryToken()
            <input type="hidden" name="Year" value="@Model.Year" />
            <input type="hidden" name="Month" value="@Model.Month" />
            <input type="hidden" name="Source" value="@Model.Source" />

            <div class="fm-month-setup-list">
                @for (var index = 0; index < Model.MissingPermanentTemplates.Count; index++)
                {
                    var template = Model.MissingPermanentTemplates[index];
                    <label class="fm-month-setup-row">
                        <input type="hidden" name="Items[@index].TemplateId" value="@template.Id" />
                        <input type="checkbox" name="Items[@index].Include" value="true" checked />
                        <input type="hidden" name="Items[@index].Include" value="false" />
                        <span class="fm-month-setup-copy">
                            <strong>@template.Name</strong>
                            <small>Repeats every month</small>
                        </span>
                        <span class="fm-month-setup-amount">
                            <span aria-hidden="true">£</span>
                            <input name="Items[@index].Amount"
                                   type="number"
                                   min="0"
                                   step="0.01"
                                   inputmode="decimal"
                                   value="@template.DefaultAmount.ToString("0.00", CultureInfo.InvariantCulture)"
                                   aria-label="Amount for @template.Name" />
                        </span>
                    </label>
                }
            </div>

            <div class="fm-month-setup-actions">
                <button class="button primary" type="submit">Add selected entries</button>
                <span>Amounts can be adjusted before they are added.</span>
            </div>
        </form>
    </section>
}

<div class="fm-workspace-grid">
    <section class="fm-workspace-list" aria-labelledby="entries-title">
        <div class="fm-workspace-section-head">
            <div>
                <p class="eyebrow">Selected month</p>
                <h2 id="entries-title">Recorded entries</h2>
            </div>
            <a class="button" asp-controller="Dashboard" asp-action="Index" asp-route-year="@Model.Year" asp-route-month="@Model.Month">Back to dashboard</a>
        </div>

        @if (Model.Rows.Count == 0)
        {
            <div class="fm-workspace-empty">
                <i data-lucide="inbox"></i>
                <strong>@Model.EmptyTitle</strong>
                <span>@Model.EmptyDescription</span>
            </div>
        }
        else
        {
            <div class="fm-workspace-rows">
                @foreach (var row in Model.Rows.OrderBy(x => x.Date).ThenBy(x => x.DisplayName))
                {
                    <article class="fm-workspace-row" id="entry-@row.Id">
                        <div class="fm-workspace-row-icon"><i data-lucide="@Model.Icon"></i></div>
                        <div class="fm-workspace-row-copy">
                            @{
                                var repeatsMonthly = Model.IsPermanent(row.Name);
                            }
                            <strong>@row.DisplayName</strong>
                            <span>
                                @row.Date.ToString("dd MMM yyyy")
                                @if (!string.IsNullOrWhiteSpace(row.Category))
                                {
                                    <text> · @row.Category</text>
                                }
                            </span>
                            @if (canEdit && Model.SupportsPermanentEntries)
                            {
                                <form class="fm-recurring-state-form"
                                      asp-controller="MonthlyMoney"
                                      asp-action="SetPermanent"
                                      method="post">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="source" value="@row.Source" />
                                    <input type="hidden" name="id" value="@row.Id" />
                                    <input type="hidden" name="year" value="@Model.Year" />
                                    <input type="hidden" name="month" value="@Model.Month" />
                                    <input class="fm-recurring-next-value" type="hidden" name="isPermanent" value="@(!repeatsMonthly)" />
                                    <button class="fm-recurring-state @(repeatsMonthly ? "is-recurring" : "is-one-off")"
                                            type="submit"
                                            role="switch"
                                            aria-checked="@repeatsMonthly.ToString().ToLowerInvariant()"
                                            aria-label="@(repeatsMonthly ? "Stop repeating this entry each month" : "Repeat this entry each month")"
                                            title="@(repeatsMonthly ? "Stop repeating this entry each month" : "Repeat this entry each month")">
                                        <span class="fm-recurring-switch" aria-hidden="true"><span></span></span>
                                        <span class="fm-recurring-label">@(repeatsMonthly ? "Repeats monthly" : "One-off")</span>
                                    </button>
                                    <span class="fm-recurring-feedback fm-visually-hidden" role="status" aria-live="polite"></span>
                                </form>
                            }
                            else if (Model.SupportsPermanentEntries)
                            {
                                <small class="fm-recurring-readonly">@(repeatsMonthly ? "Repeats monthly" : "One-off")</small>
                            }
                            @if (!string.IsNullOrWhiteSpace(row.Notes))
                            {
                                <small>@row.Notes</small>
                            }
                        </div>
                        @if (canEdit)
                        {
                            <div class="fm-workspace-row-amount">
                                <button class="fm-inline-amount-trigger"
                                        type="button"
                                        aria-expanded="false"
                                        aria-controls="amount-editor-@row.Id"
                                        title="Update this month's amount">
                                    <span>@row.Amount.ToString("C", gb)</span>
                                    <i data-lucide="pencil"></i>
                                </button>

                                <form id="amount-editor-@row.Id"
                                      class="fm-inline-amount-form"
                                      asp-controller="MonthlyMoney"
                                      asp-action="UpdateAmount"
                                      method="post"
                                      hidden>
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="source" value="@row.Source" />
                                    <input type="hidden" name="id" value="@row.Id" />
                                    <input type="hidden" name="year" value="@Model.Year" />
                                    <input type="hidden" name="month" value="@Model.Month" />
                                    <span aria-hidden="true">£</span>
                                    <input class="fm-inline-amount-input"
                                           name="amount"
                                           type="number"
                                           min="0"
                                           step="0.01"
                                           inputmode="decimal"
                                           value="@row.Amount.ToString("0.00", CultureInfo.InvariantCulture)"
                                           aria-label="Amount for @row.DisplayName"
                                           required />
                                    <button class="button primary" type="submit">Save</button>
                                    <button class="button fm-inline-amount-cancel" type="button">Cancel</button>
                                </form>
                            </div>

                            <div class="fm-workspace-row-actions">
                                <a class="button"
                                   asp-controller="Dashboard"
                                   asp-action="EditPayment"
                                   asp-route-source="@row.Source"
                                   asp-route-id="@row.Id"
                                   asp-route-year="@Model.Year"
                                   asp-route-month="@Model.Month">
                                    Edit
                                </a>
                                <form asp-controller="Dashboard"
                                      asp-action="DeletePayment"
                                      method="post"
                                      data-confirm="Delete this item?">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="year" value="@Model.Year" />
                                    <input type="hidden" name="month" value="@Model.Month" />
                                    <input type="hidden" name="source" value="@row.Source" />
                                    <input type="hidden" name="id" value="@row.Id" />
                                    <input type="hidden" name="returnAnchor" value="@Model.Source" />
                                    <button class="button danger-inline" type="submit">Delete</button>
                                </form>
                            </div>
                        }
                        else
                        {
                            <div class="fm-workspace-row-amount">@row.Amount.ToString("C", gb)</div>
                        }
                    </article>
                }
            </div>
        }
    </section>

    <aside class="fm-workspace-entry-card" aria-labelledby="add-entry-title">
        <p class="eyebrow">Quick entry</p>
        <h2 id="add-entry-title">@Model.AddTitle</h2>
        <p class="muted">Choose a previous entry to prefill the form, or create a new one.</p>
        <p class="fm-keyboard-hint"><kbd>Enter</kbd> saves · <kbd>Esc</kbd> clears the form</p>

        @if (!string.IsNullOrWhiteSpace(workspaceError))
        {
            <div class="fm-workspace-form-error" role="alert">@workspaceError</div>
        }

        @if (canEdit)
        {
            <form asp-controller="Dashboard"
                  asp-action="AddPayment"
                  method="post"
                  id="quick-entry-form"
                  class="fm-workspace-form remembered-payment-form"
                  data-options="@optionsJson"
                  data-default-date="@defaultEntryDate.ToString("yyyy-MM-dd")">
                @Html.AntiForgeryToken()
                <input type="hidden" name="year" value="@Model.Year" />
                <input type="hidden" name="month" value="@Model.Month" />
                <input type="hidden" name="source" value="@Model.Source" />
                <input type="hidden" name="returnAnchor" value="@Model.Source" />

                @if (Model.IsMoneyPots)
                {
                    <label>
                        @Model.ExistingLabel
                        <select class="payment-name" name="name" required>
                            <option value="">Choose an active money pot...</option>
                            @foreach (var pot in Model.PotOptions)
                            {
                                <option value="@pot.Name" selected="@(draftName == pot.Name ? "selected" : null)">@pot.Name · @pot.AllocatedAmount.ToString("C", gb)</option>
                            }
                        </select>
                    </label>
                    <p class="muted fm-workspace-form-hint">Create and configure pots from the main <a asp-controller="SavingPots" asp-action="Index">Money Pots page</a>.</p>
                }
                else
                {
                    <label>
                        @Model.ExistingLabel
                        @if (Model.ExistingOptions.Count > 25)
                        {
                            <input class="existing-choice"
                                   list="workspace-existing-options"
                                   placeholder="Search previous entries..."
                                   autocomplete="off" />
                            <datalist id="workspace-existing-options">
                                @foreach (var option in Model.ExistingOptions)
                                {
                                    <option value="@option.Name"></option>
                                }
                            </datalist>
                        }
                        else
                        {
                            <select class="existing-choice">
                                <option value="">Choose an existing entry...</option>
                                @foreach (var option in Model.ExistingOptions)
                                {
                                    <option value="@option.Name">@option.Name</option>
                                }
                            </select>
                        }
                    </label>

                    <label>
                        @Model.NameLabel
                        <input class="payment-name" name="name" value="@draftName" required autocomplete="off" />
                    </label>
                }

                <label>
                    Amount
                    <input class="payment-amount" name="amount" type="number" min="0" step="0.01" value="@draftAmount" required inputmode="decimal" />
                </label>

                <label>
                    Date
                    <input class="payment-date" name="date" type="date" value="@entryDateValue" required />
                </label>

                @if (Model.SupportsCategory)
                {
                    <label>
                        Category
                        <input class="payment-category" name="category" value="@draftCategory" autocomplete="off" />
                    </label>
                }

                @if (Model.SupportsType)
                {
                    <label>
                        Type
                        <input class="payment-type" name="type" value="@draftType" autocomplete="off" />
                    </label>
                }

                @if (Model.SupportsLength)
                {
                    <label>
                        Length in months
                        <input class="payment-length" name="length" type="number" min="1" step="1" value="@draftLength" />
                    </label>
                }

                <label>
                    @Model.NotesLabel
                    <textarea class="payment-notes" name="notes" rows="3">@draftNotes</textarea>
                </label>

                @if (Model.SupportsPermanentEntries)
                {
                    <label class="fm-checkbox-row">
                        <input name="isPermanent" type="checkbox" value="true" />
                        <span>
                            <strong>Repeats every month</strong>
                            <small>The next month starts with the latest amount you recorded.</small>
                        </span>
                    </label>
                }

                <button class="primary" type="submit">@(Model.IsMoneyPots ? "Add contribution" : "Save entry")</button>
            </form>
        }
        else
        {
            <div class="fm-workspace-empty compact">
                <i data-lucide="lock-keyhole"></i>
                <strong>Read-only mode</strong>
                <span>Log in to add or edit monthly entries.</span>
            </div>
        }
    </aside>
</div>

@if (canEdit && Model.IsCarryOverEligible)
{
    <section class="fm-workspace-footer-card">
        <div>
            <p class="eyebrow">Next month</p>
            <h2>Prepare @Model.NextMonth.ToString("MMMM yyyy")</h2>
            <p class="muted">Add all missing recurring entries using their latest amounts. Existing entries are left unchanged.</p>
        </div>
        <a class="button primary"
           asp-controller="Dashboard"
           asp-action="PrepareNextMonth"
           asp-route-year="@Model.Year"
           asp-route-month="@Model.Month">
            Prepare next month
        </a>
    </section>
}

@section Scripts
{
    <script>
        document.querySelectorAll('.remembered-payment-form').forEach(form => {
            const options = JSON.parse(form.dataset.options || '[]');
            const picker = form.querySelector('.existing-choice');

            picker?.addEventListener('change', () => {
                const chosenName = picker.value.trim().toLowerCase();
                const found = options.find(option => option.Name.toLowerCase() === chosenName);

                if (!found) {
                    return;
                }

                const setValue = (selector, value) => {
                    const field = form.querySelector(selector);
                    if (field) field.value = value ?? '';
                };

                setValue('.payment-name', found.Name);
                setValue('.payment-amount', found.Amount);
                setValue('.payment-category', found.Category);
                setValue('.payment-type', found.Type);
                setValue('.payment-length', found.Length);
                setValue('.payment-notes', found.Notes);

                form.querySelector('.payment-amount')?.focus();
            });
        });

        document.querySelectorAll('.remembered-payment-form').forEach(form => {
            const firstField = form.querySelector('.payment-name, select.payment-name, .existing-choice');
            const amountField = form.querySelector('.payment-amount');
            const dateField = form.querySelector('.payment-date');
            const notesField = form.querySelector('.payment-notes');

            const focusFirstField = () => {
                const target = form.querySelector('select.payment-name') || form.querySelector('.existing-choice') || form.querySelector('.payment-name');
                target?.focus();
            };

            form.addEventListener('keydown', event => {
                if (event.key === 'Escape') {
                    event.preventDefault();
                    form.reset();
                    if (dateField) dateField.value = form.dataset.defaultDate || '';
                    focusFirstField();
                    return;
                }

                if (event.key !== 'Enter' || event.shiftKey || event.ctrlKey || event.altKey || event.metaKey) {
                    return;
                }

                if (event.target === notesField) {
                    event.preventDefault();
                    form.requestSubmit();
                    return;
                }

                if (event.target instanceof HTMLTextAreaElement) {
                    return;
                }

                event.preventDefault();
                form.requestSubmit();
            });

            if (new URLSearchParams(window.location.search).get('focus') === 'quick-entry') {
                requestAnimationFrame(focusFirstField);
            }

            if (@Json.Serialize(!string.IsNullOrWhiteSpace(workspaceError))) {
                requestAnimationFrame(() => {
                    const invalidTarget = !firstField?.value ? firstField : amountField;
                    invalidTarget?.focus();
                    invalidTarget?.select?.();
                });
            }
        });


        document.querySelectorAll('.fm-recurring-state-form').forEach(form => {
            const button = form.querySelector('.fm-recurring-state');
            const nextValue = form.querySelector('.fm-recurring-next-value');
            const label = form.querySelector('.fm-recurring-label');
            const feedback = form.querySelector('.fm-recurring-feedback');

            if (!button || !nextValue || !label) {
                return;
            }

            form.addEventListener('submit', async event => {
                event.preventDefault();

                if (button.disabled) {
                    return;
                }

                button.disabled = true;
                button.setAttribute('aria-busy', 'true');
                if (feedback) feedback.textContent = 'Saving recurring status.';

                try {
                    const response = await fetch(form.action, {
                        method: 'POST',
                        body: new FormData(form),
                        headers: {
                            'X-Requested-With': 'XMLHttpRequest'
                        }
                    });

                    if (!response.ok) {
                        throw new Error(`Unable to update recurring status (${response.status}).`);
                    }

                    const result = await response.json();
                    const repeatsMonthly = result.isPermanent === true;

                    button.classList.toggle('is-recurring', repeatsMonthly);
                    button.classList.toggle('is-one-off', !repeatsMonthly);
                    button.setAttribute('aria-checked', String(repeatsMonthly));
                    button.setAttribute('aria-label', repeatsMonthly
                        ? 'Stop repeating this entry each month'
                        : 'Repeat this entry each month');
                    button.title = repeatsMonthly
                        ? 'Stop repeating this entry each month'
                        : 'Repeat this entry each month';
                    label.textContent = repeatsMonthly ? 'Repeats monthly' : 'One-off';
                    nextValue.value = String(!repeatsMonthly);
                    if (feedback) {
                        feedback.textContent = result.message || 'Recurring status updated.';
                    }
                } catch (error) {
                    if (feedback) feedback.textContent = error instanceof Error ? error.message : 'Unable to update recurring status.';
                } finally {
                    button.disabled = false;
                    button.removeAttribute('aria-busy');
                }
            });
        });

        document.querySelectorAll('.fm-workspace-row').forEach(row => {
            const trigger = row.querySelector('.fm-inline-amount-trigger');
            const editor = row.querySelector('.fm-inline-amount-form');
            const input = row.querySelector('.fm-inline-amount-input');
            const cancel = row.querySelector('.fm-inline-amount-cancel');

            if (!trigger || !editor || !input || !cancel) {
                return;
            }

            const openEditor = () => {
                trigger.hidden = true;
                editor.hidden = false;
                trigger.setAttribute('aria-expanded', 'true');
                input.focus();
                input.select();
            };

            const closeEditor = () => {
                editor.hidden = true;
                trigger.hidden = false;
                trigger.setAttribute('aria-expanded', 'false');
                trigger.focus();
            };

            trigger.addEventListener('click', openEditor);
            cancel.addEventListener('click', closeEditor);

            input.addEventListener('keydown', event => {
                if (event.key === 'Escape') {
                    event.preventDefault();
                    closeEditor();
                }
            });
        });

        if (window.location.hash) {
            const updatedRow = document.querySelector(window.location.hash);
            updatedRow?.classList.add('fm-workspace-row-updated');
        }
    </script>
}
