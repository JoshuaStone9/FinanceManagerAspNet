@model FinanceManagerAspNet.Models.MonthlyFundingReview
@using System.Globalization
@{
    ViewData["Title"] = "Monthly Funding Review";
    var gb = CultureInfo.GetCultureInfo("en-GB");
    var previous = Model.ReviewMonth.AddMonths(-1);
    var next = Model.ReviewMonth.AddMonths(1);
}

<section class="hero card">
    <div>
        <p class="eyebrow">Phase 5.1</p>
        <h1>Monthly Funding Review</h1>
        <p class="muted">Review planned funding, actual contributions, recovery activity, excess and attention items for @Model.MonthLabel.</p>
    </div>
    <a class="secondary" asp-controller="SavingPots" asp-action="Index">Household Reserve</a>
</section>

<section class="card">
    <div class="section-head">
        <div>
            <p class="eyebrow">Review period</p>
            <h2>@Model.MonthLabel</h2>
        </div>
        <div class="inline-actions">
            <a class="secondary button" asp-action="Index" asp-route-year="@previous.Year" asp-route-month="@previous.Month">Previous month</a>
            <a class="secondary button" asp-action="Index" asp-route-year="@next.Year" asp-route-month="@next.Month">Next month</a>
        </div>
    </div>
    <form method="get" class="account-form">
        <label>Month
            <select name="month">
                @for (var month = 1; month <= 12; month++)
                {
                    <option value="@month" selected="@(month == Model.Month)">@CultureInfo.CurrentCulture.DateTimeFormat.GetMonthName(month)</option>
                }
            </select>
        </label>
        <label>Year<input type="number" name="year" min="2000" max="2100" value="@Model.Year" /></label>
        <button class="primary" type="submit">Open review</button>
    </form>
</section>

<section class="grid cards-4 compact-grid">
    <article class="card"><p class="eyebrow">Planned</p><h2>@Model.PlannedTotal.ToString("C", gb)</h2><p class="muted">Expected funding</p></article>
    <article class="card"><p class="eyebrow">Actual contributions</p><h2>@Model.ActualTotal.ToString("C", gb)</h2><p class="muted">Money recorded this month</p></article>
    <article class="card"><p class="eyebrow">Effective funding</p><h2>@Model.EffectiveFundingTotal.ToString("C", gb)</h2><p class="muted">Including carried excess used</p></article>
    <article class="card"><p class="eyebrow">Remaining</p><h2>@Model.RemainingTotal.ToString("C", gb)</h2><p class="muted">Still required for the month</p></article>
</section>

<section class="grid cards-4 compact-grid">
    <article class="card"><p class="eyebrow">Recovery applied</p><h2>@Model.RecoveryAppliedTotal.ToString("C", gb)</h2></article>
    <article class="card"><p class="eyebrow">Genuine excess</p><h2>@Model.GenuineExcessTotal.ToString("C", gb)</h2></article>
    <article class="card"><p class="eyebrow">Carried excess used</p><h2>@Model.CarriedExcessUsedTotal.ToString("C", gb)</h2></article>
    <article class="card"><p class="eyebrow">Shortfall created</p><h2>@Model.ShortfallTotal.ToString("C", gb)</h2></article>
</section>

<section class="card">
    <div class="section-head">
        <div><p class="eyebrow">Pot-by-pot review</p><h2>Funding outcomes</h2></div>
        <p class="muted">@Model.FundedPotCount funded · @Model.AttentionPotCount need attention</p>
    </div>
    <div class="table-wrap">
        <table>
            <thead><tr><th>Pot</th><th>Status</th><th>Planned</th><th>Actual</th><th>Effective</th><th>Remaining</th><th>Recovery</th><th>Excess used</th><th>Genuine excess</th></tr></thead>
            <tbody>
            @if (Model.PotRows.Count == 0)
            {
                <tr><td colspan="9" class="muted">No pot funding records are available for this month.</td></tr>
            }
            @foreach (var row in Model.PotRows)
            {
                <tr>
                    <td><a asp-controller="SavingPots" asp-action="Index" asp-fragment="pot-@row.PotId"><strong>@row.PotName</strong></a><br/><span class="muted">Priority @row.Priority</span></td>
                    <td><span class="status @row.StatusCssClass">@row.Status</span></td>
                    <td>@row.PlannedAmount.ToString("C", gb)</td>
                    <td>@row.ActualAmount.ToString("C", gb)</td>
                    <td>@row.EffectiveFunding.ToString("C", gb)</td>
                    <td>@row.RemainingAmount.ToString("C", gb)</td>
                    <td>@row.RecoveryApplied.ToString("C", gb)</td>
                    <td>@row.CarriedExcessUsed.ToString("C", gb)</td>
                    <td>@row.GenuineExcess.ToString("C", gb)</td>
                </tr>
            }
            </tbody>
        </table>
    </div>
</section>

<section class="grid two-col">
    <article class="card">
        <div class="section-head"><div><p class="eyebrow">Automation</p><h2>Reminders created</h2></div><strong>@Model.ReminderCount</strong></div>
        @if (Model.Reminders.Count == 0)
        {
            <p class="muted">No reminders were created during this month.</p>
        }
        else
        {
            <div class="stack-list">
                @foreach (var reminder in Model.Reminders.Take(8))
                {
                    <div><strong>@reminder.Title</strong><br/><span class="muted">@(reminder.PotName ?? "General") · due @reminder.DueDate.ToString("dd MMM yyyy") · @reminder.Status</span></div>
                }
            </div>
        }
        <a class="secondary button" asp-controller="Reminders" asp-action="Index">View reminders</a>
    </article>

    <article class="card">
        <div class="section-head"><div><p class="eyebrow">Recovery actions</p><h2>Recommendations applied</h2></div><strong>@Model.RecommendationApplicationCount</strong></div>
        <h3>@Model.RecommendationApplicationTotal.ToString("C", gb)</h3>
        <p class="muted">Total recovery recommendation value applied during @Model.MonthLabel.</p>
        <a class="secondary button" asp-controller="Events" asp-action="Index" asp-route-eventType="RecoveryRecommendationApplied" asp-route-from="@Model.ReviewMonth.ToString("yyyy-MM-dd")" asp-route-to="@Model.ReviewMonth.AddMonths(1).AddDays(-1).ToString("yyyy-MM-dd")">View applications</a>
    </article>
</section>

<section class="card">
    <div class="section-head"><div><p class="eyebrow">Audit trail</p><h2>Finance events</h2></div><strong>@Model.Events.Count</strong></div>
    <div class="table-wrap">
        <table>
            <thead><tr><th>Date</th><th>Event</th><th>Details</th><th>Amount</th><th>Source</th></tr></thead>
            <tbody>
            @if (Model.Events.Count == 0)
            {
                <tr><td colspan="5" class="muted">No finance events were recorded during this month.</td></tr>
            }
            @foreach (var item in Model.Events.Take(20))
            {
                <tr><td>@item.OccurredAt.ToLocalTime().ToString("dd MMM yyyy HH:mm")</td><td><strong>@item.Title</strong><br/><span class="muted">@item.EventType</span></td><td>@item.Description</td><td>@(item.Amount?.ToString("C", gb) ?? "—")</td><td>@item.Source</td></tr>
            }
            </tbody>
        </table>
    </div>
    <a class="secondary button" asp-controller="Events" asp-action="Index" asp-route-from="@Model.ReviewMonth.ToString("yyyy-MM-dd")" asp-route-to="@Model.ReviewMonth.AddMonths(1).AddDays(-1).ToString("yyyy-MM-dd")">View full event history</a>
</section>
